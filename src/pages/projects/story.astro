---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { signatureProjects } from '../../data/projects';

const project = signatureProjects[0];

const pageTitle = `${project.title} — Blueprint & Story | Leo Club of EIC`;
const pageDescription = "Explore the complete operational blueprint, beneficiary scope, and volunteer timeline for our upcoming 2026/2027 term humanitarian initiative.";

const blueprintPhases = [
  {
    step: "01",
    title: "Placeholder Blueprint Phase Heading",
    period: "Weeks 1 – 3",
    desc: "Placeholder text: Field reconnaissance, needs assessment, and community survey parameters to be finalized."
  },
  {
    step: "02",
    title: "Placeholder Blueprint Phase Heading",
    period: "Weeks 4 – 6",
    desc: "Placeholder text: Resource allocation, logistics planning, and community partner allocations."
  },
  {
    step: "03",
    title: "Placeholder Blueprint Phase Heading",
    period: "Weeks 7 – 8",
    desc: "Placeholder text: Youth volunteer mobilization, team briefings, and safety protocol reviews."
  },
  {
    step: "04",
    title: "Placeholder Blueprint Phase Heading",
    period: "Execution Phase",
    desc: "Placeholder text: Project execution, transparent impact recording, and district documentation."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} showIntro={false}>
  <main class="story-page" id="main-content">
    <div class="story-ambient-glow" aria-hidden="true"></div>

    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="editorial-breadcrumbs" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/projects" class="crumb-link">Initiatives & Projects</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current" aria-current="page">Project Blueprint</span>
      </nav>

      <!-- Story Hero Header -->
      <header class="story-hero text-center">
        <div class="header-pill-cluster">
          <span class="term-badge">{project.date}</span>
          <span class="category-badge">{project.category}</span>
          <span class="status-badge">{project.tag}</span>
        </div>

        <h1 class="story-title">
          {project.title}
        </h1>

        <p class="story-lead">
          {project.summary}
        </p>

        <!-- Impact Metrics Bar -->
        <div class="story-metrics-strip" role="region" aria-label="Project metrics">
          {project.impactMetrics.map((m) => (
            <div class="metric-item">
              <span class="metric-num">{m.value}</span>
              <span class="metric-label">{m.label}</span>
            </div>
          ))}
          <div class="metric-item">
            <span class="metric-num">100%</span>
            <span class="metric-label">Integrity & Audit</span>
          </div>
        </div>
      </header>

      <!-- Article Story Sections -->
      <div class="story-layout-grid">
        <!-- Main Narrative Column -->
        <article class="story-narrative-col">
          <section class="narrative-block">
            <span class="section-kicker">01. Executive Mandate</span>
            <h2 class="section-h2">The Calling & Vision</h2>
            <p>
              As the Leo Club of Ethos International enters the 2026–2027 operational term, our leadership cabinet is formulating a new generation of high-leverage community welfare initiatives. Designed from the ground up to address acute socio-economic challenges, this project represents our enduring mission: empowering youth to spark genuine humanitarian relief.
            </p>
            <p>
              Detailed project parameters, site allocations, and target demographic data are currently being curated by our executive planning committee and will be ratified following the official 2026/2027 district investiture.
            </p>
          </section>

          <section class="narrative-block">
            <span class="section-kicker">02. Four-Stage Framework</span>
            <h2 class="section-h2">Operational Blueprint</h2>
            <div class="blueprint-cards-list">
              {blueprintPhases.map((phase) => (
                <div class="blueprint-card">
                  <div class="phase-step-badge">{phase.step}</div>
                  <div class="phase-copy">
                    <div class="phase-top">
                      <h3 class="phase-title">{phase.title}</h3>
                      <span class="phase-period">{phase.period}</span>
                    </div>
                    <p class="phase-desc">{phase.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <section class="narrative-block">
            <span class="section-kicker">03. Stewardship & Transparency</span>
            <h2 class="section-h2">Governance and District Standards</h2>
            <p>
              Every rupee raised and volunteer hour invested is strictly governed under District 306 D2 oversight, backed by the Lions Club of Colombo West. We maintain complete financial receipts, public donation ledgers, and verified photographic archives for all our community projects.
            </p>
          </section>
        </article>

        <!-- Sidebar Quick Info -->
        <aside class="story-sidebar-col">
          <div class="sidebar-sticky-card">
            <h3 class="sidebar-heading">Project Factsheet</h3>
            <ul class="fact-list">
              <li class="fact-item">
                <span class="fact-label">Term:</span>
                <strong class="fact-val">{project.date}</strong>
              </li>
              <li class="fact-item">
                <span class="fact-label">Pillar:</span>
                <strong class="fact-val">{project.category}</strong>
              </li>
              <li class="fact-item">
                <span class="fact-label">Governing District:</span>
                <strong class="fact-val">Leo District 306 D2</strong>
              </li>
              <li class="fact-item">
                <span class="fact-label">Parent Sponsoring Club:</span>
                <strong class="fact-val">Lions Club of Colombo West</strong>
              </li>
              <li class="fact-item">
                <span class="fact-label">Status:</span>
                <span class="fact-badge">Pending Cabinet Investiture</span>
              </li>
            </ul>

            <div class="sidebar-cta-box">
              <span class="cta-kicker">Want to Join This Initiative?</span>
              <p class="cta-mini-text">Register early to receive volunteer role briefings or partner with our outreach team.</p>
              <a href="mailto:leoclubofeic@gmail.com?subject=Volunteer%20Inquiry:%20Placeholder%20Project" class="sidebar-btn">
                <span>Join Project Roster</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </aside>
      </div>

      <!-- Navigation Footer -->
      <footer class="story-nav-footer">
        <a href="/projects" class="back-link">
          <span aria-hidden="true">←</span>
          <span>Back to All Initiatives & Roadmap</span>
        </a>
        <a href="/history/awards" class="awards-jump-link">
          <span>View Past Award-Winning Projects</span>
          <span aria-hidden="true">→</span>
        </a>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  .story-page {
    position: relative;
    padding-top: calc(var(--nav-height, 72px) + 32px);
    padding-bottom: 100px;
    background: radial-gradient(circle at 50% 0%, rgba(122, 87, 184, 0.08) 0%, transparent 60%),
                radial-gradient(circle at 80% 20%, rgba(194, 155, 77, 0.06) 0%, transparent 40%),
                var(--c-surface-ivory, #FAF8FD);
    min-height: 100vh;
    overflow-x: hidden;
  }

  .story-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1000px;
    max-width: 100vw;
    height: 480px;
    background: radial-gradient(circle, rgba(122, 87, 184, 0.1) 0%, rgba(194, 155, 77, 0.08) 50%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  /* Breadcrumbs */
  .editorial-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    margin-bottom: 36px;
    color: var(--c-text-muted, #7B728E);
  }

  .crumb-link {
    color: var(--c-iris, #7A57B8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .crumb-link:hover {
    color: var(--c-gold-primary, #C29B4D);
  }

  .crumb-sep {
    opacity: 0.4;
  }

  .crumb-current {
    color: var(--c-text-primary, #211638);
    font-weight: 500;
  }

  /* Hero */
  .story-hero {
    max-width: 820px;
    margin: 0 auto 56px;
  }

  .header-pill-cluster {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }

  .term-badge {
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(122, 87, 184, 0.1);
    color: var(--c-iris, #7A57B8);
    padding: 4px 14px;
    border-radius: 9999px;
    border: 1px solid rgba(122, 87, 184, 0.25);
  }

  .category-badge {
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(194, 155, 77, 0.12);
    color: #8C6518;
    padding: 4px 14px;
    border-radius: 9999px;
    border: 1px solid rgba(194, 155, 77, 0.3);
  }

  .status-badge {
    font-size: 0.78rem;
    font-weight: 700;
    background: rgba(46, 125, 50, 0.1);
    color: #2E7D32;
    padding: 4px 14px;
    border-radius: 9999px;
    border: 1px solid rgba(46, 125, 50, 0.25);
  }

  .story-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 600;
    color: var(--c-text-primary, #211638);
    margin: 0 0 18px;
    line-height: 1.15;
  }

  .story-lead {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.65;
    color: var(--c-text-secondary, #5C5272);
    margin: 0 auto 36px;
    max-width: 720px;
  }

  /* Metrics */
  .story-metrics-strip {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(194, 155, 77, 0.35);
    border-radius: 9999px;
    padding: 12px 32px;
    box-shadow: 0 12px 30px -10px rgba(65, 41, 107, 0.1);
    gap: 32px;
    max-width: 100%;
    overflow-x: auto;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .metric-num {
    font-family: var(--font-serif, serif);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--c-gold-primary, #9B772A);
    line-height: 1;
    margin-bottom: 2px;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--c-text-secondary, #5C5272);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Layout Grid */
  .story-layout-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
    max-width: 1080px;
    margin: 0 auto 72px;
  }

  .narrative-block {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(122, 87, 184, 0.15);
    border-radius: 24px;
    padding: 36px 36px 32px;
    margin-bottom: 32px;
    box-shadow: 0 10px 30px -10px rgba(65, 41, 107, 0.06);
  }

  .section-kicker {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-gold-primary, #9B772A);
    margin-bottom: 8px;
  }

  .section-h2 {
    font-family: var(--font-serif, serif);
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--c-text-primary, #211638);
    margin: 0 0 18px;
  }

  .narrative-block p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--c-text-secondary, #5C5272);
    margin: 0 0 16px;
  }

  .narrative-block p:last-child {
    margin-bottom: 0;
  }

  /* Blueprint list */
  .blueprint-cards-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 20px;
  }

  .blueprint-card {
    display: flex;
    gap: 18px;
    background: rgba(247, 242, 255, 0.6);
    border: 1px solid rgba(122, 87, 184, 0.18);
    border-radius: 16px;
    padding: 18px 20px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .blueprint-card:hover {
    transform: translateX(4px);
    border-color: var(--c-gold-primary, #C29B4D);
  }

  .phase-step-badge {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--c-iris, #7A57B8);
    color: #FAF8FD;
    font-family: var(--font-serif, serif);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .phase-copy {
    flex: 1;
  }

  .phase-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .phase-title {
    font-family: var(--font-serif, serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--c-text-primary, #211638);
    margin: 0;
  }

  .phase-period {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-gold-primary, #9B772A);
    background: rgba(194, 155, 77, 0.12);
    padding: 2px 8px;
    border-radius: 9999px;
  }

  .phase-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--c-text-secondary, #5C5272);
    margin: 0;
  }

  /* Sidebar */
  .sidebar-sticky-card {
    position: sticky;
    top: calc(var(--nav-height, 72px) + 24px);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(194, 155, 77, 0.35);
    border-radius: 24px;
    padding: 28px 24px;
    box-shadow: 0 12px 36px -10px rgba(65, 41, 107, 0.1);
  }

  .sidebar-heading {
    font-family: var(--font-serif, serif);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--c-text-primary, #211638);
    margin: 0 0 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(122, 87, 184, 0.12);
  }

  .fact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fact-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fact-label {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-text-muted, #7B728E);
  }

  .fact-val {
    font-size: 0.92rem;
    color: var(--c-text-primary, #211638);
    font-weight: 600;
  }

  .fact-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.74rem;
    font-weight: 600;
    background: rgba(194, 155, 77, 0.15);
    color: #8C6518;
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .sidebar-cta-box {
    background: linear-gradient(145deg, rgba(33, 22, 56, 0.96) 0%, rgba(14, 7, 26, 0.98) 100%);
    border-radius: 18px;
    padding: 20px;
    color: #FAF8FD;
    text-align: center;
  }

  .cta-kicker {
    display: block;
    font-family: var(--font-serif, serif);
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 6px;
    color: #FAF8FD;
  }

  .cta-mini-text {
    font-size: 0.8rem;
    line-height: 1.5;
    color: rgba(250, 248, 253, 0.75);
    margin: 0 0 14px;
  }

  .sidebar-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--c-gold-primary, #C29B4D);
    color: #140C20;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 8px 18px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sidebar-btn:hover {
    background: #D9B368;
    transform: translateY(-1px);
  }

  /* Footer Links */
  .story-nav-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    max-width: 1080px;
    margin: 0 auto;
    padding-top: 32px;
    border-top: 1px solid rgba(122, 87, 184, 0.15);
    flex-wrap: wrap;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--c-iris, #7A57B8);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .back-link:hover {
    gap: 12px;
  }

  .awards-jump-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--c-gold-primary, #9B772A);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .awards-jump-link:hover {
    gap: 12px;
  }

  /* Responsive Adjustments */
  @media (max-width: 860px) {
    .story-layout-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .narrative-block {
      padding: 24px 20px;
    }

    .story-metrics-strip {
      flex-direction: column;
      border-radius: 20px;
      gap: 12px;
      width: 100%;
    }

    .story-nav-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
