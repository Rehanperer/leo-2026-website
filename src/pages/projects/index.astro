---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { signatureProjects } from '../../data/projects';

const pageTitle = "Initiatives & Projects — Leo Club of EIC";
const pageDescription = "Explore our 2026–2027 humanitarian project roadmap, community service pillars, and youth empowerment initiatives.";

const pillars = [
  { id: 'all', label: 'All Pillars' },
  { id: 'health', label: 'Community Health' },
  { id: 'education', label: 'Youth & Education' },
  { id: 'environment', label: 'Environment' },
  { id: 'relief', label: 'Welfare & Relief' }
];

const roadmapMilestones = [
  {
    phase: "Phase 01",
    period: "Q1 2026",
    title: "Placeholder Milestone Heading",
    desc: "Placeholder text: Comprehensive community surveys and operational framework currently being prepared for the incoming term.",
    status: "In Progress"
  },
  {
    phase: "Phase 02",
    period: "Q2 2026",
    title: "Placeholder Milestone Heading",
    desc: "Placeholder text: Humanitarian service scope and volunteer mobilization roadmap pending cabinet ratification.",
    status: "Upcoming"
  },
  {
    phase: "Phase 03",
    period: "Q3 2026",
    title: "Placeholder Milestone Heading",
    desc: "Placeholder text: Youth leadership initiative and community outreach details to be announced.",
    status: "Upcoming"
  },
  {
    phase: "Phase 04",
    period: "Q4 2027",
    title: "Placeholder Milestone Heading",
    desc: "Placeholder text: Term impact evaluation, volunteer service hours auditing, and annual report publication.",
    status: "Upcoming"
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} showIntro={false}>
  <main class="projects-page" id="main-content">
    <div class="projects-ambient-glow" aria-hidden="true"></div>

    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="editorial-breadcrumbs" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current" aria-current="page">Initiatives & Projects</span>
      </nav>

      <!-- Page Hero -->
      <header class="projects-hero text-center">
        <div class="header-pill-badge">
          <span class="pill-sparkle">✦</span>
          <span>2026 – 2027 Term Roadmap</span>
        </div>
        <h1 class="projects-title">
          Humanitarian <em>Initiatives & Projects</em>
        </h1>
        <p class="projects-subtitle">
          From grassroots community service drives to international youth empowerment, discover how the Leo Club of Ethos International channels passion into measurable impact.
        </p>
      </header>

      <!-- Pillar Filter Pills -->
      <section class="pillar-filter-bar" aria-label="Filter by service pillar">
        <div class="filter-pills-row" role="tablist">
          {pillars.map((p, idx) => (
            <button 
              type="button" 
              class={`pillar-btn ${idx === 0 ? 'active' : ''}`}
              data-pillar={p.id}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              {p.label}
            </button>
          ))}
        </div>
      </section>

      <!-- Active Term Project Cards -->
      <section class="projects-cards-section" aria-label="Current Projects">
        <div class="projects-cards-grid">
          {signatureProjects.map((project) => (
            <article class="featured-project-card" data-category="all health education environment relief">
              <div class="card-ambient-accent" aria-hidden="true"></div>
              
              <div class="card-top-meta">
                <span class="term-badge">{project.date}</span>
                <span class="category-badge">{project.category}</span>
                <span class="status-tag status-upcoming">{project.tag}</span>
              </div>

              <div class="card-main-content">
                <h2 class="project-card-heading">{project.title}</h2>
                <p class="project-card-summary">{project.summary}</p>
                
                <!-- Metrics Bar -->
                <div class="metrics-grid">
                  {project.impactMetrics.map((m) => (
                    <div class="metric-box">
                      <span class="metric-val">{m.value}</span>
                      <span class="metric-label">{m.label}</span>
                    </div>
                  ))}
                </div>
              </div>

              <footer class="card-action-footer">
                <a href={`/projects/${project.storySlug}`} class="explore-story-btn">
                  <span>Read Full Project Story & Blueprint</span>
                  <span class="btn-arrow" aria-hidden="true">→</span>
                </a>
              </footer>
            </article>
          ))}
        </div>
      </section>

      <!-- 2026/2027 Term Roadmap Pipeline -->
      <section class="roadmap-section" aria-label="Term Roadmap">
        <div class="section-header text-center">
          <span class="eyebrow eyebrow-gold">Strategic Milestones</span>
          <h2 class="roadmap-heading">2026 – 2027 Term Roadmap</h2>
          <p class="roadmap-sub">A four-stage operational trajectory driving meaningful youth engagement and humanitarian relief.</p>
        </div>

        <div class="roadmap-timeline">
          {roadmapMilestones.map((item, idx) => (
            <div class="roadmap-node">
              <div class="node-marker-col">
                <div class="node-circle">{idx + 1}</div>
                {idx < roadmapMilestones.length - 1 && <div class="node-line" aria-hidden="true"></div>}
              </div>
              <div class="node-content-card">
                <div class="node-meta">
                  <span class="node-phase">{item.phase}</span>
                  <span class="node-period">{item.period}</span>
                  <span class={`node-status-pill ${item.status === 'In Progress' ? 'status-active' : ''}`}>{item.status}</span>
                </div>
                <h3 class="node-title">{item.title}</h3>
                <p class="node-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Propose Initiative CTA -->
      <section class="propose-initiative-cta">
        <div class="cta-card">
          <div class="cta-content">
            <span class="eyebrow eyebrow-gold">Community Partnership</span>
            <h3 class="cta-heading">Have a Cause That Needs Youth Action?</h3>
            <p class="cta-desc">
              We collaborate with schools, hospitals, local municipal councils, and non-profit organizations to champion transformative projects.
            </p>
            <div class="cta-buttons">
              <a href="mailto:leoclubofeic@gmail.com" class="cta-primary-btn">
                <span>Partner With Us</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
              <a href="/newsletter" class="cta-secondary-btn">
                <span>Browse Past Project Dispatches</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .projects-page {
    position: relative;
    padding-top: calc(var(--nav-height, 72px) + 32px);
    padding-bottom: 100px;
    background: radial-gradient(circle at 50% 0%, rgba(122, 87, 184, 0.08) 0%, transparent 60%),
                radial-gradient(circle at 80% 20%, rgba(194, 155, 77, 0.06) 0%, transparent 40%),
                var(--c-surface-ivory, #FAF8FD);
    min-height: 100vh;
    overflow-x: hidden;
  }

  .projects-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1000px;
    max-width: 100vw;
    height: 500px;
    background: radial-gradient(circle, rgba(122, 87, 184, 0.1) 0%, rgba(194, 155, 77, 0.07) 50%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  /* Breadcrumbs */
  .editorial-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    margin-bottom: 36px;
    color: var(--c-text-muted, #7B728E);
  }

  .crumb-link {
    color: var(--c-iris, #7A57B8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .crumb-link:hover {
    color: var(--c-gold-primary, #C29B4D);
  }

  .crumb-sep {
    opacity: 0.4;
  }

  .crumb-current {
    color: var(--c-text-primary, #211638);
    font-weight: 500;
  }

  /* Hero */
  .projects-hero {
    max-width: 780px;
    margin: 0 auto 48px;
  }

  .header-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(122, 87, 184, 0.1);
    border: 1px solid rgba(122, 87, 184, 0.35);
    padding: 6px 18px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-iris, #7A57B8);
    margin-bottom: 18px;
  }

  .pill-sparkle {
    color: var(--c-gold-primary, #C29B4D);
  }

  .projects-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(2.4rem, 5.2vw, 3.8rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--c-text-primary, #211638);
    margin: 0 0 18px;
  }

  .projects-title em {
    font-style: italic;
    color: var(--c-iris, #7A57B8);
  }

  .projects-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.65;
    color: var(--c-text-secondary, #5C5272);
    margin: 0 auto;
    max-width: 660px;
  }

  /* Pillar Filter */
  .pillar-filter-bar {
    margin-bottom: 48px;
  }

  .filter-pills-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pillar-btn {
    border: 1px solid rgba(122, 87, 184, 0.2);
    background: #FFFFFF;
    color: var(--c-text-secondary, #5C5272);
    padding: 8px 20px;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pillar-btn:hover {
    border-color: var(--c-iris, #7A57B8);
    color: var(--c-iris, #7A57B8);
    transform: translateY(-1px);
  }

  .pillar-btn.active {
    background: var(--c-iris, #7A57B8);
    border-color: var(--c-iris, #7A57B8);
    color: #FAF8FD;
    box-shadow: 0 4px 14px rgba(122, 87, 184, 0.3);
  }

  /* Cards Grid */
  .projects-cards-section {
    margin-bottom: 84px;
  }

  .projects-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 880px;
    margin: 0 auto;
    gap: 32px;
  }

  .featured-project-card {
    position: relative;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(250, 246, 255, 0.9) 100%);
    border: 1.5px solid rgba(194, 155, 77, 0.35);
    border-radius: 28px;
    padding: 36px 36px 32px;
    box-shadow: 0 20px 50px -12px rgba(65, 41, 107, 0.12), 0 0 30px rgba(194, 155, 77, 0.08);
    backdrop-filter: blur(12px);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .featured-project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 60px -15px rgba(65, 41, 107, 0.18), 0 0 40px rgba(194, 155, 77, 0.15);
  }

  .card-ambient-accent {
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(194, 155, 77, 0.14) 0%, transparent 70%);
    pointer-events: none;
  }

  .card-top-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .term-badge {
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(122, 87, 184, 0.1);
    color: var(--c-iris, #7A57B8);
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(122, 87, 184, 0.25);
  }

  .category-badge {
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(194, 155, 77, 0.12);
    color: #8C6518;
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(194, 155, 77, 0.3);
  }

  .status-tag {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 9999px;
  }

  .status-upcoming {
    background: rgba(46, 125, 50, 0.1);
    color: #2E7D32;
    border: 1px solid rgba(46, 125, 50, 0.25);
  }

  .project-card-heading {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 600;
    color: var(--c-text-primary, #211638);
    margin: 0 0 14px;
    line-height: 1.25;
  }

  .project-card-summary {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--c-text-secondary, #5C5272);
    margin: 0 0 28px;
    max-width: 720px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 32px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(122, 87, 184, 0.15);
    border-radius: 18px;
    padding: 20px 24px;
  }

  .metric-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .metric-val {
    font-family: var(--font-serif, serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--c-gold-primary, #9B772A);
    line-height: 1.1;
    margin-bottom: 4px;
  }

  .metric-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--c-text-secondary, #5C5272);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-action-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .explore-story-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--c-iris, #7A57B8);
    color: #FAF8FD;
    padding: 12px 26px;
    border-radius: 9999px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(122, 87, 184, 0.3);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .explore-story-btn:hover {
    background: var(--c-gold-primary, #9B772A);
    box-shadow: 0 8px 22px rgba(194, 155, 77, 0.35);
    transform: translateY(-2px);
  }

  .explore-story-btn .btn-arrow {
    transition: transform 0.2s ease;
  }

  .explore-story-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Roadmap Section */
  .roadmap-section {
    margin-bottom: 96px;
  }

  .section-header {
    max-width: 680px;
    margin: 0 auto 52px;
  }

  .eyebrow-gold {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-gold-primary, #9B772A);
    margin-bottom: 10px;
  }

  .roadmap-heading {
    font-family: var(--font-serif, serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: var(--c-text-primary, #211638);
    margin: 0 0 14px;
  }

  .roadmap-sub {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--c-text-secondary, #5C5272);
    margin: 0;
  }

  .roadmap-timeline {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .roadmap-node {
    display: flex;
    gap: 24px;
  }

  .node-marker-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 48px;
    flex-shrink: 0;
  }

  .node-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid var(--c-iris, #7A57B8);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif, serif);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--c-iris, #7A57B8);
    box-shadow: 0 4px 12px rgba(122, 87, 184, 0.18);
    z-index: 1;
  }

  .node-line {
    width: 2px;
    flex: 1;
    background: linear-gradient(to bottom, var(--c-iris, #7A57B8), rgba(122, 87, 184, 0.15));
    margin-top: 8px;
    min-height: 40px;
  }

  .node-content-card {
    flex: 1;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(122, 87, 184, 0.15);
    border-radius: 20px;
    padding: 22px 26px;
    box-shadow: 0 8px 24px -8px rgba(65, 41, 107, 0.06);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .node-content-card:hover {
    transform: translateX(4px);
    border-color: var(--c-gold-primary, #C29B4D);
  }

  .node-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .node-phase {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-iris, #7A57B8);
  }

  .node-period {
    font-size: 0.78rem;
    color: var(--c-text-muted, #7B728E);
    font-weight: 500;
  }

  .node-status-pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9999px;
    background: rgba(122, 87, 184, 0.1);
    color: var(--c-iris, #7A57B8);
  }

  .node-status-pill.status-active {
    background: rgba(46, 125, 50, 0.15);
    color: #2E7D32;
    border: 1px solid rgba(46, 125, 50, 0.3);
  }

  .node-title {
    font-family: var(--font-serif, serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--c-text-primary, #211638);
    margin: 0 0 6px;
  }

  .node-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--c-text-secondary, #5C5272);
    margin: 0;
  }

  /* Propose CTA */
  .propose-initiative-cta {
    max-width: 880px;
    margin: 0 auto;
  }

  .cta-card {
    background: linear-gradient(145deg, rgba(33, 22, 56, 0.97) 0%, rgba(14, 7, 26, 0.98) 100%);
    border: 1px solid rgba(194, 155, 77, 0.4);
    border-radius: 28px;
    padding: 44px 40px;
    box-shadow: 0 24px 60px -15px rgba(14, 7, 26, 0.5), 0 0 40px rgba(194, 155, 77, 0.15);
    color: #FAF8FD;
    text-align: center;
  }

  .cta-content {
    max-width: 620px;
    margin: 0 auto;
  }

  .cta-heading {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 600;
    margin: 12px 0 14px;
    color: #FAF8FD;
  }

  .cta-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(250, 248, 253, 0.8);
    margin: 0 0 28px;
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cta-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--c-gold-primary, #C29B4D);
    color: #140C20;
    padding: 12px 28px;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(194, 155, 77, 0.35);
    transition: all 0.25s ease;
  }

  .cta-primary-btn:hover {
    background: #D9B368;
    transform: translateY(-2px);
  }

  .cta-secondary-btn {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.1);
    color: #FAF8FD;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 12px 24px;
    border-radius: 9999px;
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 0.25s ease;
  }

  .cta-secondary-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .featured-project-card {
      padding: 24px 20px;
    }

    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .roadmap-node {
      gap: 16px;
    }

    .node-content-card {
      padding: 18px 16px;
    }

    .cta-card {
      padding: 32px 20px;
    }
  }
</style>

<script>
  function initPillarFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-pillar]');
    const cards = document.querySelectorAll<HTMLElement>('.featured-project-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const pillar = btn.getAttribute('data-pillar') || 'all';
        cards.forEach((c) => {
          const cats = c.getAttribute('data-category') || '';
          if (pillar === 'all' || cats.includes(pillar)) {
            c.style.display = 'block';
          } else {
            c.style.display = 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPillarFilter);
  } else {
    initPillarFilter();
  }
  document.addEventListener('astro:page-load', initPillarFilter);
</script>
