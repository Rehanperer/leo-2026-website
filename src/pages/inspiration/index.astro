---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RippleDistortion from '../../components/RippleDistortion.astro';
import { inspirationData } from '../../data/inspiration';

const pageTitle = "Source of Inspiration — Leo Club of EIC";
const pageDescription = "Explore the founding history, core values, and guiding torch of the Leo Club of Ethos International from 2022 to the present.";
---

<BaseLayout title={pageTitle} description={pageDescription} showIntro={false}>
  <link rel="preload" as="image" href="/blooming-iris-globe.webp" type="image/webp" fetchpriority="high" slot="head" />
  <main class="inspiration-page" id="main-content">
    <div class="inspiration-ambient-glow" aria-hidden="true"></div>

    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="editorial-breadcrumbs" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current" aria-current="page">Source of Inspiration</span>
      </nav>

      <!-- Page Hero & Creed -->
      <header class="inspiration-hero text-center">
        <div class="header-pill-badge">
          <span class="pill-sparkle">✦</span>
          <span>Our Guiding Ethos</span>
        </div>
        <h1 class="inspiration-title">
          Source of <em>Inspiration</em>
        </h1>
        <p class="inspiration-creed">
          “{inspirationData.creed}”
        </p>

        <!-- Living Ethos Ceremonial Medallion -->
        <div class="inspiration-medallion-wrapper">
          <div class="medallion-halo" aria-hidden="true"></div>
          <div class="medallion-ring">
            <div class="medallion-inner-frame">
              <RippleDistortion 
                src="/blooming-iris-globe.webp" 
                alt="The Living Ethos — Leo Club of EIC"
                aspectRatio="1 / 1"
                brushSize={120}
                strength={0.2}
                swirl={0.7}
                tint="#C29B4D"
                tintAmount={0.12}
                dispersion={0.012}
                glint={0.4}
                background="transparent"
              />
            </div>
          </div>
          <div class="medallion-badge-pill">
            <span class="pill-sparkle">✦</span>
            <span>Interactive Living Ethos Emblem — Glide or tap to ripple</span>
            <span class="pill-sparkle">✦</span>
          </div>
        </div>
      </header>

      <!-- 4-Stage Chronological Journey -->
      <section class="journey-section" aria-label="Our History Timeline">
        <div class="section-heading text-center">
          <span class="eyebrow eyebrow-gold">Our Living Legacy</span>
          <h2 class="journey-title">The Journey Through the Years</h2>
          <p class="journey-subtitle">
            From our founding roots in 2022 under the Lions Club of Colombo West to an expansive youth movement across Sri Lanka.
          </p>
        </div>

        <div class="timeline-stream">
          {inspirationData.milestones.map((m, idx) => {
            const isEven = idx % 2 === 1;
            return (
              <article class={`timeline-row ${isEven ? 'row-reversed' : ''}`}>
                <div class="timeline-visual-col">
                  <div class="timeline-card-image-frame">
                    <img src={m.image} alt={m.title} class="timeline-img" loading="lazy" decoding="async" />
                    <span class="timeline-period-badge">{m.period}</span>
                    <span class="timeline-tag-stamp">{m.tag}</span>
                  </div>
                </div>

                <div class="timeline-copy-col">
                  <span class="milestone-num">0{idx + 1}</span>
                  <span class="eyebrow eyebrow-gold">{m.period} Milestone</span>
                  <h3 class="milestone-name">{m.title}</h3>
                  <p class="milestone-desc">{m.description}</p>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- Core Values Section -->
      <section class="values-section" aria-label="Values That Define Us">
        <div class="section-heading text-center">
          <span class="eyebrow eyebrow-gold">Triad of Purpose</span>
          <h2 class="values-title">Values That <em>Define Us</em></h2>
          <p class="values-subtitle">
            Central to the Leo Club of Ethos are the timeless values of leadership, service, and community fellowship.
          </p>
        </div>

        <div class="values-grid">
          {inspirationData.values.map((v) => (
            <div class="value-card card-glass" style={`--glow-color: ${v.glowColor};`}>
              <div class="value-glow-orb" aria-hidden="true"></div>
              <span class="value-lead">{v.lead}</span>
              <h3 class="value-name">{v.title}</h3>
              <p class="value-desc">{v.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- The Torch Legacy Tribute & Founders Callout -->
      <section class="torch-quote-section">
        <div class="torch-quote-card">
          <div class="torch-quote-inner">
            <span class="torch-symbol">✦</span>
            <blockquote class="torch-main-quote">
              “{inspirationData.torchQuote}”
            </blockquote>
            <span class="torch-author">— Our Founding Promise</span>
            <div class="quote-divider" aria-hidden="true"></div>
            <p class="torch-tribute-text">
              {inspirationData.foundingTribute}
            </p>
            <div class="torch-actions">
              <a href="/team" class="btn btn-primary">
                Meet the Active Cabinet →
              </a>
              <a href="/history/leaders" class="btn btn-secondary">
                View Former Leaders Archive
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .inspiration-page {
    position: relative;
    padding: 120px 0 100px;
    background: var(--c-bg, #FAF8FD);
    color: var(--c-text-primary, #211638);
    min-height: 100vh;
    overflow: hidden;
  }

  .inspiration-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1000px;
    height: 700px;
    background: radial-gradient(circle, rgba(122, 87, 184, 0.12) 0%, rgba(194, 155, 77, 0.08) 50%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .editorial-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
    font-size: 0.875rem;
    color: var(--c-text-tertiary, #8C82A2);
  }

  .crumb-link {
    color: var(--c-iris, #7A57B8);
    text-decoration: none;
    font-weight: 500;
  }
  .crumb-link:hover { text-decoration: underline; }
  .crumb-current { color: var(--c-text-secondary, #5C5272); font-weight: 600; }

  /* Hero */
  .inspiration-hero {
    max-width: 960px;
    margin: 0 auto 80px;
  }

  .header-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 9999px;
    background: var(--c-iris-soft, #EDE6F9);
    border: 1px solid var(--c-border-subtle, rgba(122, 87, 184, 0.15));
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--c-iris-deep, #54398A);
    margin-bottom: 16px;
  }

  .pill-sparkle { color: var(--c-gold, #C29B4D); }

  .inspiration-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--c-text-primary, #211638);
    margin: 0 0 16px;
  }

  .inspiration-title em {
    font-style: italic;
    color: var(--c-iris, #7A57B8);
  }

  .inspiration-creed {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.5;
    color: var(--c-text-secondary, #5C5272);
    margin: 0 auto 36px;
    max-width: 760px;
  }

  /* Living Ethos Medallion */
  .inspiration-medallion-wrapper {
    position: relative;
    max-width: 440px;
    width: 100%;
    margin: 12px auto 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .medallion-halo {
    position: absolute;
    inset: 10%;
    background: radial-gradient(circle, rgba(122, 87, 184, 0.28) 0%, rgba(194, 155, 77, 0.2) 50%, transparent 75%);
    filter: blur(44px);
    z-index: 0;
    pointer-events: none;
    animation: pulse-halo 6s ease-in-out infinite alternate;
  }

  @keyframes pulse-halo {
    0% { transform: scale(0.92); opacity: 0.65; }
    100% { transform: scale(1.08); opacity: 0.95; }
  }

  .medallion-ring {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 380px;
    border-radius: 50%;
    padding: 10px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(240, 233, 252, 0.6) 50%, rgba(194, 155, 77, 0.25) 100%);
    box-shadow: 
      0 20px 50px -10px rgba(65, 41, 107, 0.16),
      0 0 0 1px rgba(194, 155, 77, 0.35),
      inset 0 0 20px rgba(194, 155, 77, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
  }

  .medallion-ring:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 
      0 28px 65px -12px rgba(65, 41, 107, 0.22),
      0 0 0 1.5px rgba(194, 155, 77, 0.5),
      inset 0 0 24px rgba(194, 155, 77, 0.2);
  }

  .medallion-inner-frame {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    background: radial-gradient(circle at 50% 45%, #FFFFFF 0%, #F5F0FC 60%, #E9DEFA 100%);
    border: 1px solid rgba(122, 87, 184, 0.18);
  }

  .medallion-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(194, 155, 77, 0.35);
    padding: 7px 18px;
    border-radius: 9999px;
    color: var(--c-text-primary, #211638);
    font-size: 0.8rem;
    font-weight: 500;
    box-shadow: 0 4px 16px rgba(65, 41, 107, 0.08);
  }

  /* Journey Stream */
  .journey-section {
    margin-bottom: 96px;
  }

  .section-heading {
    max-width: 680px;
    margin: 0 auto 56px;
  }

  .journey-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(2rem, 3.8vw, 3rem);
    color: var(--c-text-primary, #211638);
    margin: 8px 0 12px;
  }

  .journey-subtitle {
    font-size: 1rem;
    color: var(--c-text-secondary, #5C5272);
    line-height: 1.6;
    margin: 0;
  }

  .timeline-stream {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid var(--c-border-subtle, rgba(122, 87, 184, 0.12));
    border-radius: 28px;
    padding: 32px;
    box-shadow: 0 12px 36px -6px rgba(33, 22, 56, 0.05);
  }

  .timeline-row.row-reversed {
    grid-template-columns: 1fr 1.1fr;
  }

  .timeline-row.row-reversed .timeline-visual-col {
    order: 2;
  }

  .timeline-card-image-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #000;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  }

  .timeline-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .timeline-card-image-frame:hover .timeline-img {
    transform: scale(1.04);
  }

  .timeline-period-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 14px;
    background: rgba(14, 7, 26, 0.82);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(194, 155, 77, 0.4);
    border-radius: 9999px;
    color: #FAF8FD;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .timeline-tag-stamp {
    position: absolute;
    bottom: 14px;
    right: 14px;
    padding: 4px 10px;
    background: #C29B4D;
    color: #140A24;
    border-radius: 6px;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .timeline-copy-col {
    padding: 16px;
  }

  .milestone-num {
    display: block;
    font-family: var(--font-serif, serif);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(122, 87, 184, 0.2);
    margin-bottom: -10px;
  }

  .milestone-name {
    font-family: var(--font-serif, serif);
    font-size: 2.2rem;
    color: var(--c-text-primary, #211638);
    margin: 6px 0 16px;
  }

  .milestone-desc {
    font-size: 1.05rem;
    color: var(--c-text-secondary, #5C5272);
    line-height: 1.7;
    margin: 0;
  }

  /* Values Triad */
  .values-section {
    margin-bottom: 96px;
  }

  .values-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(2rem, 3.8vw, 3rem);
    color: var(--c-text-primary, #211638);
    margin: 8px 0 12px;
  }

  .values-title em {
    font-style: italic;
    color: var(--c-iris, #7A57B8);
  }

  .values-subtitle {
    font-size: 1rem;
    color: var(--c-text-secondary, #5C5272);
    line-height: 1.6;
    margin: 0;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .value-card {
    position: relative;
    background: #FFFFFF;
    border: 1px solid var(--c-border-subtle, rgba(122, 87, 184, 0.12));
    border-radius: 24px;
    padding: 36px 32px;
    overflow: hidden;
    box-shadow: 0 12px 32px -6px rgba(33, 22, 56, 0.05);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .value-card:hover {
    transform: translateY(-4px);
    border-color: rgba(194, 155, 77, 0.4);
  }

  .value-glow-orb {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--glow-color, rgba(122, 87, 184, 0.2));
    filter: blur(40px);
    pointer-events: none;
  }

  .value-lead {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-gold-deep, #9F7B2F);
    margin-bottom: 8px;
  }

  .value-name {
    font-family: var(--font-serif, serif);
    font-size: 1.85rem;
    color: var(--c-text-primary, #211638);
    margin: 0 0 14px;
  }

  .value-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--c-text-secondary, #5C5272);
    margin: 0;
  }

  /* Torch Quote Banner */
  .torch-quote-section {
    margin-top: 40px;
  }

  .torch-quote-card {
    background: linear-gradient(135deg, #24143D 0%, #150B27 100%);
    border: 1px solid var(--c-border-gold, rgba(194, 155, 77, 0.35));
    border-radius: 32px;
    padding: 64px 36px;
    color: #FAF8FD;
    text-align: center;
    box-shadow: 0 24px 64px rgba(20, 10, 36, 0.4);
  }

  .torch-quote-inner {
    max-width: 780px;
    margin: 0 auto;
  }

  .torch-symbol {
    font-size: 1.8rem;
    color: #C29B4D;
    display: inline-block;
    margin-bottom: 16px;
  }

  .torch-main-quote {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-style: italic;
    line-height: 1.35;
    color: #FFFFFF;
    margin: 0 0 16px;
  }

  .torch-author {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #C29B4D;
  }

  .quote-divider {
    width: 60px;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    margin: 24px auto;
  }

  .torch-tribute-text {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(243, 237, 250, 0.78);
    margin-bottom: 32px;
  }

  .torch-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 992px) {
    .values-grid { grid-template-columns: 1fr; }
    .timeline-row { grid-template-columns: 1fr; gap: 24px; padding: 24px; }
    .timeline-row.row-reversed { grid-template-columns: 1fr; }
    .timeline-row.row-reversed .timeline-visual-col { order: 0; }
  }

  @media (max-width: 640px) {
    .torch-quote-card { padding: 40px 20px; }
    .hero-torch-canvas-frame { border-radius: 18px; }
  }
</style>
