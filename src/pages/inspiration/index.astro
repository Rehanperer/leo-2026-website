---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BotanicalAccent from '../../components/BotanicalAccent.astro';
import { inspirationData } from '../../data/inspiration';

const pageTitle = "Source of Inspiration — Leo Club of EIC";
const pageDescription = "Explore the founding heraldry, sacred creed, and living legacy of the Leo Club of EIC from 2022 to the present.";
---

<BaseLayout title={pageTitle} description={pageDescription} showIntro={false}>
  <link rel="preload" as="image" href="/blooming-iris-globe.webp" type="image/webp" fetchpriority="high" slot="head" />
  <link rel="preload" as="image" href="/crest.webp" type="image/webp" fetchpriority="high" slot="head" />
  
  <main class="inspiration-page" id="main-content">
    <!-- Atmospheric Floral & Celestial Nebulae -->
    <div class="inspiration-ambient-glow" aria-hidden="true"></div>
    <div class="inspiration-azure-nebula" aria-hidden="true"></div>
    <div class="inspiration-iris-nebula" aria-hidden="true"></div>

    <!-- Framing Watercolor Botanical Corner Sprays -->
    <BotanicalAccent position="top-left" size="clamp(240px, 30vw, 420px)" opacity={0.35} />
    <BotanicalAccent position="bottom-right" size="clamp(220px, 28vw, 380px)" opacity={0.32} />

    <div class="container">
      <!-- Editorial Breadcrumb Navigation -->
      <nav class="editorial-breadcrumbs" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current" aria-current="page">Source of Inspiration</span>
      </nav>

      <!-- Monumental Altar Hero: The Soul of Our Movement -->
      <header class="inspiration-hero text-center">
        <div class="header-pill-badge">
          <span class="pill-sparkle">✦</span>
          <span>THE LIVING TORCH & SACRED ETHOS</span>
          <span class="pill-sparkle">✦</span>
        </div>
        
        <h1 class="inspiration-title">
          Source of <em>Inspiration</em>
        </h1>

        <p class="inspiration-motto-callout">
          “{inspirationData.motto}”
        </p>

        <!-- Monumental Celestial Relic Medallion (Earth & Blooming Iris) -->
        <div class="celestial-relic-stage">
          <div class="relic-halo" aria-hidden="true"></div>
          
          <div class="relic-frame">
            <!-- Outer Laurel Gold Bezel -->
            <div class="relic-bezel-gold" aria-hidden="true"></div>
            <!-- Inner Earth Azure Orbit Ring -->
            <div class="relic-orbit-azure" aria-hidden="true"></div>
            
            <div class="relic-artwork-wrapper">
              <img 
                src="/blooming-iris-globe.webp" 
                alt="The Living Iris wrapping the Earth Globe" 
                class="relic-artwork-img"
                width="220"
                height="220"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          </div>

          <div class="relic-creed-box">
            <blockquote class="inspiration-creed">
              “{inspirationData.creed}”
            </blockquote>
            <div class="provenance-chip">
              <span class="prov-dot">✦</span>
              <span>CHARTERED 2022 • LIONS CLUB OF COLOMBO WEST • DISTRICT 306 D2</span>
              <span class="prov-dot">✦</span>
            </div>
          </div>
        </div>
      </header>

      <!-- SECTION 1: Sacred Heraldry of the Crest -->
      <section class="heraldry-section" aria-label="Symbolism of the Club Crest">
        <div class="section-heading text-center">
          <span class="eyebrow eyebrow-gold">The Geometry of Purpose</span>
          <h2 class="section-headline">
            Sacred Heraldry of <em>Our Crest</em>
          </h2>
          <p class="section-subcopy">
            Every curve and color in our emblem tells the story of our founding philosophy—uniting earth, bloom, and honor in one sacred seal.
          </p>
        </div>

        <div class="heraldry-grid">
          {inspirationData.heraldry.map((item) => (
            <article class="heraldry-card" style={`--symbol-color: ${item.color};`}>
              <div class="heraldry-card-ambient" aria-hidden="true"></div>
              <div class="heraldry-glyph-box">
                <span class="h-glyph">{item.glyph}</span>
              </div>
              <span class="heraldry-subtitle">{item.subtitle}</span>
              <h3 class="heraldry-title">{item.title}</h3>
              <p class="heraldry-desc">{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- SECTION 2: The Imperial Triad of Values -->
      <section class="values-section" aria-label="Values That Define Us">
        <div class="section-heading text-center">
          <span class="eyebrow eyebrow-gold">The Triad of Virtue</span>
          <h2 class="section-headline">
            Values That <em>Guide Our Steps</em>
          </h2>
          <p class="section-subcopy">
            Three eternal pillars that inspire our leaders to act with courage, serve with empathy, and cherish every fellowship.
          </p>
        </div>

        <div class="values-monoliths-grid">
          {inspirationData.values.map((v) => (
            <div class="value-monolith-card" style={`--glow-color: ${v.glowColor};`}>
              <div class="monolith-glass-glow" aria-hidden="true"></div>
              
              <div class="monolith-header">
                <span class="monolith-numeral">{v.numeral}</span>
                <span class="monolith-lead">{v.lead}</span>
              </div>

              <h3 class="monolith-title">{v.title}</h3>
              <p class="monolith-desc">{v.description}</p>

              <div class="monolith-footer">
                <div class="monolith-line" aria-hidden="true"></div>
                <span class="monolith-symbolism">✦ {v.symbolism}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION 3: The Heritage Chronology (2022 to Present) -->
      <section class="journey-section" aria-label="Our History Timeline">
        <div class="section-heading text-center">
          <span class="eyebrow eyebrow-gold">Tapestry of Service</span>
          <h2 class="section-headline">
            The Living Journey <em>(2022 – Present)</em>
          </h2>
          <p class="section-subcopy">
            A chronicle of compassionate leadership, expanding from our founding charter into a vibrant national youth movement.
          </p>
        </div>

        <div class="heritage-timeline-stream">
          <div class="timeline-golden-spine" aria-hidden="true"></div>

          {inspirationData.milestones.map((m, idx) => {
            const isEven = idx % 2 === 1;
            return (
              <article class={`timeline-station ${isEven ? 'station-reversed' : ''}`}>
                <div class="station-visual-frame">
                  <div class="station-image-border">
                    <img 
                      src={m.image} 
                      alt={m.title} 
                      class="station-img" 
                      loading="lazy" 
                      decoding="async" 
                    />
                    <div class="station-img-gradient" aria-hidden="true"></div>
                    <span class="station-era-badge">{m.tag}</span>
                  </div>
                </div>

                <!-- Central Timeline Node Sparkle -->
                <div class="station-node-marker" aria-hidden="true">
                  <span class="node-sparkle">✦</span>
                </div>

                <div class="station-narrative-card">
                  <div class="narrative-meta">
                    <span class="station-period-chip">{m.period}</span>
                    <span class="station-highlight-tag">{m.highlight}</span>
                  </div>
                  
                  <h3 class="station-title">{m.title}</h3>
                  <p class="station-copy">{m.description}</p>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- SECTION 4: Sanctuary of the Living Torch -->
      <section class="torch-sanctuary-section" aria-label="Sanctuary of the Living Torch">
        <div class="torch-sanctuary-card">
          <!-- Background Atmospheric Radial Glows -->
          <div class="sanctuary-glow-top" aria-hidden="true"></div>
          <div class="sanctuary-glow-bot" aria-hidden="true"></div>

          <div class="torch-sanctuary-inner">
            <div class="torch-crest-icon">
              <span class="flame-glyph">🔥</span>
            </div>

            <span class="sanctuary-eyebrow">OUR LIVING BEACON</span>

            <blockquote class="torch-main-quote">
              “{inspirationData.torchQuote}”
            </blockquote>

            <span class="torch-author">— Founding Creed of the Leo Movement</span>

            <div class="sanctuary-divider" aria-hidden="true">
              <span class="div-star">✦</span>
              <span class="div-line"></span>
              <span class="div-star">✦</span>
            </div>

            <p class="torch-tribute-text">
              {inspirationData.foundingTribute}
            </p>

            <div class="sanctuary-actions">
              <a href="/team" class="sanctuary-btn-primary">
                <span>Meet Our Active Cabinet</span>
                <span class="btn-arrow">→</span>
              </a>
              <a href="/history/leaders" class="sanctuary-btn-secondary">
                <span>View Former Leaders Archive</span>
                <span class="btn-arrow">⚜</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  /* =========================================================================
     Page Baseline & Atmospheric Environments
     ========================================================================= */
  .inspiration-page {
    position: relative;
    padding: clamp(100px, 12vw, 140px) 0 clamp(80px, 10vw, 120px);
    background: var(--c-bg, #FAF8FD);
    color: var(--c-text-primary, #211638);
    min-height: 100vh;
    overflow: hidden;
  }

  /* Atmospheric Environmental Nebulae */
  .inspiration-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1100px;
    height: 700px;
    background: radial-gradient(circle, rgba(122, 87, 184, 0.14) 0%, rgba(194, 155, 77, 0.08) 45%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .inspiration-azure-nebula {
    position: absolute;
    top: 25%;
    right: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(62, 132, 194, 0.12) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
  }

  .inspiration-iris-nebula {
    position: absolute;
    top: 60%;
    left: -120px;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, rgba(122, 87, 184, 0.13) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
  }

  /* Breadcrumbs */
  .editorial-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(24px, 4vw, 40px);
    font-size: 0.875rem;
    color: var(--c-text-tertiary, #8C82A2);
    position: relative;
    z-index: 2;
  }

  .crumb-link {
    color: var(--c-iris, #7A57B8);
    text-decoration: none;
    font-weight: 500;
  }

  .crumb-link:hover { text-decoration: underline; }
  .crumb-current { color: var(--c-text-secondary, #5C5272); font-weight: 600; }

  /* =========================================================================
     Hero Section & Celestial Relic Centerpiece
     ========================================================================= */
  .inspiration-hero {
    max-width: 980px;
    margin: 0 auto clamp(60px, 8vw, 100px);
    position: relative;
    z-index: 2;
  }

  .header-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    border-radius: 9999px;
    background: rgba(237, 230, 249, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(194, 155, 77, 0.35);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--c-iris-deep, #54398A);
    margin-bottom: 20px;
    box-shadow: 0 4px 14px rgba(122, 87, 184, 0.08);
  }

  .pill-sparkle { color: var(--c-gold, #C29B4D); font-size: 0.72rem; }

  .inspiration-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--c-text-primary, #211638);
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .inspiration-title em {
    font-style: italic;
    color: var(--c-iris, #7A57B8);
  }

  .inspiration-motto-callout {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    color: var(--c-gold-deep, #9F7B2F);
    letter-spacing: 0.02em;
    margin: 0 auto 36px;
  }

  /* Celestial Relic Stage */
  .celestial-relic-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 10px;
  }

  .relic-halo {
    position: absolute;
    top: 40px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(62, 132, 194, 0.3) 0%, rgba(122, 87, 184, 0.28) 45%, rgba(194, 155, 77, 0.18) 70%, transparent 80%);
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
  }

  .relic-frame {
    position: relative;
    width: clamp(200px, 24vw, 260px);
    height: clamp(200px, 24vw, 260px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .relic-frame:hover {
    transform: scale(1.04) rotate(2deg);
  }

  .relic-bezel-gold {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 2.5px;
    background: linear-gradient(135deg, #F4E8C9 0%, #C29B4D 50%, #9F7B2F 100%);
    box-shadow: 
      0 12px 32px rgba(194, 155, 77, 0.35),
      0 0 24px rgba(62, 132, 194, 0.25);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .relic-orbit-azure {
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    border: 1.5px dashed rgba(62, 132, 194, 0.55);
    animation: slowRelicOrbit 36s linear infinite;
    pointer-events: none;
  }

  @keyframes slowRelicOrbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .relic-artwork-wrapper {
    width: calc(100% - 18px);
    height: calc(100% - 18px);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.98) 60%, rgba(240, 246, 255, 0.9) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    box-shadow: inset 0 2px 8px rgba(62, 132, 194, 0.15);
  }

  .relic-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 6px 14px rgba(33, 22, 56, 0.12));
  }

  .relic-creed-box {
    margin-top: 32px;
    max-width: 720px;
    z-index: 1;
  }

  .inspiration-creed {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.55;
    color: var(--c-text-primary, #211638);
    margin: 0 0 16px;
  }

  .provenance-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--c-gold-deep, #9F7B2F);
    padding: 5px 14px;
    background: rgba(194, 155, 77, 0.08);
    border: 1px solid rgba(194, 155, 77, 0.3);
    border-radius: 9999px;
  }

  .prov-dot { font-size: 0.65rem; color: var(--c-gold, #C29B4D); }

  /* =========================================================================
     Section Common Headers
     ========================================================================= */
  .section-heading {
    max-width: 760px;
    margin: 0 auto clamp(40px, 6vw, 64px);
    position: relative;
    z-index: 2;
  }

  .section-headline {
    font-family: var(--font-serif, serif);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--c-text-primary, #211638);
    margin: 8px 0 14px;
  }

  .section-headline em {
    font-style: italic;
    color: var(--c-iris, #7A57B8);
  }

  .section-subcopy {
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    color: var(--c-text-secondary, #5C5272);
    line-height: 1.6;
    margin: 0 auto;
    max-width: 640px;
  }

  /* =========================================================================
     SECTION 1: Sacred Heraldry Grid
     ========================================================================= */
  .heraldry-section {
    margin-bottom: clamp(70px, 10vw, 110px);
    position: relative;
    z-index: 2;
  }

  .heraldry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 22px;
  }

  .heraldry-card {
    position: relative;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 1px solid rgba(194, 155, 77, 0.28);
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 12px 32px -8px rgba(33, 22, 56, 0.08);
    transition: 
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .heraldry-card:hover {
    transform: translateY(-6px);
    border-color: rgba(194, 155, 77, 0.55);
    box-shadow: 0 20px 48px -10px rgba(33, 22, 56, 0.14);
  }

  .heraldry-card-ambient {
    position: absolute;
    top: -30px;
    right: -30px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--symbol-color) 0%, transparent 70%);
    opacity: 0.18;
    filter: blur(24px);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .heraldry-card:hover .heraldry-card-ambient {
    opacity: 0.32;
  }

  .heraldry-glyph-box {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(194, 155, 77, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    box-shadow: 0 4px 12px rgba(33, 22, 56, 0.06);
  }

  .h-glyph {
    font-size: 1.6rem;
  }

  .heraldry-subtitle {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-gold-deep, #9F7B2F);
    margin-bottom: 4px;
  }

  .heraldry-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--c-text-primary, #211638);
    margin: 0 0 10px;
  }

  .heraldry-desc {
    font-size: 0.88rem;
    color: var(--c-text-secondary, #5C5272);
    line-height: 1.6;
    margin: 0;
  }

  /* =========================================================================
     SECTION 2: The Imperial Triad of Values (Monoliths)
     ========================================================================= */
  .values-section {
    margin-bottom: clamp(80px, 12vw, 130px);
    position: relative;
    z-index: 2;
  }

  .values-monoliths-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 28px;
  }

  .value-monolith-card {
    position: relative;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 28px;
    border: 1.5px solid rgba(194, 155, 77, 0.32);
    padding: clamp(28px, 4vw, 38px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 16px 44px -8px rgba(33, 22, 56, 0.1);
    transition: 
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .value-monolith-card:hover {
    transform: translateY(-8px);
    border-color: rgba(194, 155, 77, 0.65);
    box-shadow: 0 24px 56px -10px rgba(33, 22, 56, 0.18);
  }

  .monolith-glass-glow {
    position: absolute;
    top: -40px;
    left: -40px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow-color) 0%, transparent 70%);
    filter: blur(36px);
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .value-monolith-card:hover .monolith-glass-glow {
    opacity: 0.8;
  }

  .monolith-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .monolith-numeral {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
    color: var(--c-gold, #C29B4D);
  }

  .monolith-lead {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--c-iris-deep, #54398A);
    text-transform: uppercase;
  }

  .monolith-title {
    font-family: var(--font-serif, serif);
    font-size: 1.85rem;
    font-weight: 600;
    color: var(--c-text-primary, #211638);
    margin: 0 0 12px;
  }

  .monolith-desc {
    font-size: 0.94rem;
    color: var(--c-text-secondary, #5C5272);
    line-height: 1.65;
    margin: 0 0 24px;
    flex: 1;
  }

  .monolith-footer {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .monolith-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(194, 155, 77, 0.4), transparent);
  }

  .monolith-symbolism {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-gold-deep, #9F7B2F);
  }

  /* =========================================================================
     SECTION 3: The Heritage Chronology Stream
     ========================================================================= */
  .journey-section {
    margin-bottom: clamp(80px, 12vw, 130px);
    position: relative;
    z-index: 2;
  }

  .heritage-timeline-stream {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .timeline-golden-spine {
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
