---
import BotanicalAccent from './BotanicalAccent.astro';
import ScrollVine from './ScrollVine.astro';
---

<section id="about" class="section about-section" aria-label="About the Club">
  <!-- Scroll-triggered growing botanical vine on the left -->
  <ScrollVine side="left" height={600} />

  <!-- Botanical corner sprays framing the section -->
  <BotanicalAccent position="top-right" size="clamp(220px, 28vw, 380px)" opacity={0.36} />
  <BotanicalAccent position="bottom-left" size="clamp(200px, 25vw, 340px)" opacity={0.32} />

  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Our Guiding Legacy</span>
      <h2 class="section-title">
        Rooted in Purpose, <em>Blossoming</em> in Impact
      </h2>
      <p class="section-subtitle">
        The Leo Club of EIC brings together ambitious young minds to lead community transformation, foster lifelong fellowship, and champion social equity.
      </p>
    </div>

    <!-- Editorial Feature Spotlight -->
    <div class="about-hero-card card-glass">
      <div class="about-hero-grid">
        <div class="about-hero-copy">
          <span class="about-tag">Vision & Creed</span>
          <h3 class="about-statement">
            "We believe true leadership is not defined by authority, but by the quiet grace with which we uplift those around us."
          </h3>
          <p class="about-narrative">
            Chartered under Lions Clubs International, the Leo Club of EIC (Ethos International) stands as a beacon for youth in Colombo 7. Our membership unites passionate students and young professionals who believe that dedicated volunteerism is the highest form of self-actualization.
          </p>
          <div class="about-values-list">
            <div class="val-item">
              <span class="val-check">✓</span>
              <span><strong>L</strong>eadership Development</span>
            </div>
            <div class="val-item">
              <span class="val-check">✓</span>
              <span><strong>E</strong>xperience Through Service</span>
            </div>
            <div class="val-item">
              <span class="val-check">✓</span>
              <span><strong>O</strong>pportunity For Growth</span>
            </div>
          </div>
        </div>

        <div class="about-symbol-card">
          <div class="symbol-showcase-stage">
            <!-- Concentric celestial orbital rings behind the globe -->
            <div class="earth-orbit-ring ring-lat" aria-hidden="true"></div>
            <div class="earth-orbit-ring ring-lon" aria-hidden="true"></div>

            <!-- Atmospheric radiance glow behind the artwork -->
            <div class="earth-atmos-glow" aria-hidden="true"></div>

            <!-- Living Earth globe & blooming iris (fully unclipped) -->
            <div class="art-wrapper">
              <img 
                src="/blooming-iris-globe.webp" 
                alt="Living Earth globe encircled by the blooming Iris" 
                class="living-earth-img"
                width="280"
                height="280"
                loading="lazy"
                decoding="async"
              />
            </div>

            <!-- Floating stardust sparkles -->
            <span class="earth-stardust dust-1" aria-hidden="true">✦</span>
            <span class="earth-stardust dust-2" aria-hidden="true">✦</span>
            <span class="earth-stardust dust-3" aria-hidden="true">✦</span>
          </div>

          <div class="symbol-meta">
            <div class="earth-tag-badge">
              <span class="earth-badge-dot"></span>
              <span>Global Fellowship & Planetary Care</span>
            </div>
            <h4 class="symbol-title">The Iris & Living Earth</h4>
            <p class="symbol-desc">
              The purple iris represents wisdom, faith, and renewal, rising peacefully from the earth to symbolize our commitment to environmental harmony and global humanitarian service.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Three Tenet Pillar Columns -->
    <div class="tenets-grid">
      <div class="tenet-card card-glass">
        <div class="tenet-number">01</div>
        <h4 class="tenet-title">Ethical Youth Governance</h4>
        <p class="tenet-desc">
          Every project is managed with total transparency, rigorous planning, and an inclusive culture where every voice shapes the outcome.
        </p>
      </div>

      <div class="tenet-card card-glass">
        <div class="tenet-number">02</div>
        <h4 class="tenet-title">Direct Grassroots Service</h4>
        <p class="tenet-desc">
          We go beyond charity by directly engaging with rural schools, elderly care centers, and eco-initiatives to understand real human needs.
        </p>
      </div>

      <div class="tenet-card card-glass">
        <div class="tenet-number">03</div>
        <h4 class="tenet-title">Global Lions Network</h4>
        <p class="tenet-desc">
          Connected to over 1.4 million Lions and Leos worldwide, providing our members with international exchange, mentorship, and prestige.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    overflow-x: clip;
    background: linear-gradient(180deg, rgba(250, 248, 253, 0) 0%, rgba(243, 237, 250, 0.5) 50%, rgba(250, 248, 253, 0) 100%);
  }

  .about-hero-card {
    padding: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    background: #FFFFFF;
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-hero-grid {
      grid-template-columns: 1.35fr 0.85fr;
    }
  }

  .about-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-iris-deep);
    margin-bottom: 0.75rem;
  }

  .about-statement {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.5vw, 2.1rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--c-text-primary);
    margin-bottom: 1.25rem;
    font-style: italic;
  }

  .about-narrative {
    font-size: var(--fs-base);
    color: var(--c-text-secondary);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .about-values-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .val-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--c-text-primary);
  }

  .val-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--c-iris-mist);
    color: var(--c-iris-deep);
    font-size: 0.75rem;
    font-weight: bold;
  }

  /* Symbol card with Living Earth & Iris Showcase */
  .about-symbol-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #FAF7FD 0%, #FFFFFF 100%);
    border: 1px solid var(--c-border-subtle);
    box-shadow: 0 16px 40px -12px rgba(84, 57, 138, 0.08);
    position: relative;
    overflow: visible;
  }

  .symbol-showcase-stage {
    position: relative;
    width: clamp(210px, 24vw, 270px);
    height: clamp(210px, 24vw, 270px);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  /* Celestial Orbital Rings behind the artwork */
  .earth-orbit-ring {
    position: absolute;
    width: 78%;
    height: 78%;
    top: 14%;
    left: 11%;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .ring-lat {
    border: 1.5px dashed rgba(194, 155, 77, 0.4);
    animation: rotateLat 32s linear infinite;
  }

  .ring-lon {
    border: 1px solid rgba(122, 87, 184, 0.22);
    animation: rotateLon 48s linear infinite reverse;
    transform: rotate(25deg);
  }

  @keyframes rotateLat {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes rotateLon {
    from { transform: rotate(25deg); }
    to { transform: rotate(385deg); }
  }

  .earth-atmos-glow {
    position: absolute;
    width: 85%;
    height: 85%;
    top: 10%;
    left: 7.5%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, rgba(217, 203, 240, 0.55) 0%, rgba(244, 232, 201, 0.35) 55%, transparent 75%);
    filter: blur(14px);
    pointer-events: none;
    z-index: 0;
  }

  .art-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    overflow: visible;
  }

  .living-earth-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 14px 28px rgba(84, 57, 138, 0.16)) drop-shadow(0 4px 10px rgba(194, 155, 77, 0.12));
    transition: transform 0.6s var(--ease-apple), filter 0.6s var(--ease-apple);
    animation: floatArtwork 9s ease-in-out infinite alternate;
  }

  .about-symbol-card:hover .living-earth-img {
    transform: translateY(-5px) scale(1.04);
    filter: drop-shadow(0 18px 36px rgba(84, 57, 138, 0.22)) drop-shadow(0 6px 14px rgba(194, 155, 77, 0.18));
  }

  @keyframes floatArtwork {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(1deg); }
    100% { transform: translateY(0px) rotate(0deg); }
  }

  /* Floating Stardust */
  .earth-stardust {
    position: absolute;
    color: var(--c-gold);
    font-size: 0.8rem;
    pointer-events: none;
    z-index: 2;
    animation: twinkleDust 3.5s ease-in-out infinite;
  }

  .dust-1 {
    top: 2px;
    right: 8px;
    animation-delay: 0.2s;
  }

  .dust-2 {
    bottom: 8px;
    left: 4px;
    animation-delay: 1.5s;
    font-size: 0.7rem;
    color: var(--c-iris);
  }

  .dust-3 {
    top: 35%;
    left: -4px;
    animation-delay: 2.2s;
    font-size: 0.65rem;
    color: var(--c-gold-deep);
  }

  @keyframes twinkleDust {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.25); }
  }

  /* Badge */
  .earth-tag-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-gold-deep);
    background: rgba(194, 155, 77, 0.1);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--c-border-gold);
    margin-bottom: 0.65rem;
  }

  .earth-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-gold);
    box-shadow: 0 0 6px var(--c-gold);
  }

  .symbol-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--c-text-primary);
    margin-bottom: 0.4rem;
  }

  .symbol-desc {
    font-size: 0.84rem;
    color: var(--c-text-secondary);
    line-height: 1.6;
    max-width: 300px;
  }

  /* Tenets Grid */
  .tenets-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (min-width: 768px) {
    .tenets-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tenet-card {
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
  }

  .tenet-number {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--c-gold-deep);
    margin-bottom: 0.65rem;
  }

  .tenet-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--c-text-primary);
    margin-bottom: 0.65rem;
  }

  .tenet-desc {
    font-size: 0.9rem;
    color: var(--c-text-secondary);
    line-height: 1.65;
  }
</style>
