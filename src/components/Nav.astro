  function initNav() {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('mobile-nav-toggle');
    const drawer = document.getElementById('mobile-cinematic-drawer');
    const closeBtn = document.getElementById('mobile-drawer-close');
    const leadershipTrigger = document.getElementById('mobile-leadership-trigger');
    const leadershipSub = document.getElementById('mobile-leadership-sub');
    const replayBtn = document.getElementById('replay-bloom-btn');
    const mobileReplayBtn = document.getElementById('mobile-replay-bloom-btn');
    const dropdownWrapper = document.querySelector('.nav-dropdown-wrapper');
    const dropdownTrigger = document.querySelector('.dropdown-trigger');
    const dropdownMenu = document.querySelector('.nav-dropdown-menu');

    let dropdownTimer: any = null;

    // Sticky scroll effect
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        header?.classList.add('is-scrolled');
      } else {
        header?.classList.remove('is-scrolled');
      }
    }, { passive: true });

    // Drawer state management & Body Scroll lock
    function openDrawer() {
      toggle?.setAttribute('aria-expanded', 'true');
      drawer?.classList.add('is-open');
      drawer?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      toggle?.setAttribute('aria-expanded', 'false');
      drawer?.classList.remove('is-open');
      drawer?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    closeBtn?.addEventListener('click', closeDrawer);

    // Close when tapping links in drawer (except accordion trigger)
    drawer?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    // Accordion toggle inside mobile drawer
    leadershipTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = leadershipTrigger.getAttribute('aria-expanded') === 'true';
      leadershipTrigger.setAttribute('aria-expanded', (!isExpanded).toString());
      leadershipSub?.classList.toggle('is-open', !isExpanded);
      leadershipSub?.setAttribute('aria-hidden', isExpanded.toString());
    });

    // Keyboard support: Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDrawer();
        dropdownMenu?.classList.remove('is-open');
        dropdownWrapper?.classList.remove('is-open');
        dropdownTrigger?.setAttribute('aria-expanded', 'false');
      }
    });

    // Desktop Dropdown mouse buffer & click toggle
    dropdownWrapper?.addEventListener('mouseenter', () => {
      clearTimeout(dropdownTimer);
      dropdownMenu?.classList.add('is-open');
      dropdownWrapper.classList.add('is-open');
      dropdownTrigger?.setAttribute('aria-expanded', 'true');
    });

    dropdownWrapper?.addEventListener('mouseleave', () => {
      dropdownTimer = setTimeout(() => {
        dropdownMenu?.classList.remove('is-open');
        dropdownWrapper?.classList.remove('is-open');
        dropdownTrigger?.setAttribute('aria-expanded', 'false');
      }, 300);
    });

    dropdownTrigger?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      clearTimeout(dropdownTimer);
      dropdownMenu?.classList.add('is-open');
      dropdownWrapper?.classList.add('is-open');
      dropdownTrigger?.setAttribute('aria-expanded', 'true');
    });

    document.addEventListener('click', (e) => {
      if (!dropdownWrapper?.contains(e.target as Node)) {
        dropdownMenu?.classList.remove('is-open');
        dropdownWrapper?.classList.remove('is-open');
        dropdownTrigger?.setAttribute('aria-expanded', 'false');
      }
    });

    dropdownMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        dropdownMenu?.classList.remove('is-open');
        dropdownWrapper?.classList.remove('is-open');
        dropdownTrigger?.setAttribute('aria-expanded', 'false');
      });
    });

    // Replay bloom intro handlers
    function handleReplay(e?: Event) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      closeDrawer();

      // Scroll smoothly to top so hero section reveals cleanly
      window.scrollTo({ top: 0, behavior: 'instant' });

      if (typeof (window as any).replayCinematicIntro === 'function') {
        (window as any).replayCinematicIntro();
      } else {
        window.dispatchEvent(new CustomEvent('replay-cinematic-intro'));
      }
    }

    replayBtn?.addEventListener('click', handleReplay);
    mobileReplayBtn?.addEventListener('click', handleReplay);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
</script>
