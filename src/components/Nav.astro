---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isHome = currentPath === '/';

const resolveHref = (href: string) => {
  if (href.startsWith('#')) {
    return isHome ? href : `/${href}`;
  }
  return href;
};
---

<header class="nav-wrapper" id="site-header">
  <div class="nav-container">
    <nav class="nav-island" aria-label="Primary Navigation">
      <!-- Watercolor Iris Petal Glass Ornament (Embedded on Right Edge) -->
      <div class="nav-botanical-whisper" aria-hidden="true"></div>

      <!-- Brand Crest & Title: Earth & Blooming Iris Medallion -->
      <a href={isHome ? '#hero' : '/#hero'} class="brand-link" aria-label="Leo Club of EIC — Return to top">
        <div class="crest-frame" aria-hidden="true">
          <!-- Ambient Celestial Backlight (Earth Azure + Iris Violet) -->
          <div class="crest-glow-halo"></div>
          
          <!-- Outer Laurel Gold Bezel -->
          <div class="orbital-ring ring-laurel-gold"></div>
          
          <!-- Inner Earth Azure Orbit -->
          <div class="orbital-ring ring-earth-blue"></div>

          <!-- Central Official Club Crest -->
          <img 
            src="/crest.webp" 
            alt="Leo Club of EIC Crest" 
            class="brand-crest"
            width="40" 
            height="40" 
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="brand-copy">
          <span class="brand-title">LEO CLUB OF EIC</span>
          <span class="brand-subtitle">
            Leading with Grace <span class="sub-dot">✦</span> Colombo 7
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links: Botanical Hover & Celestial Active Capsules -->
      <ul class="nav-links" role="menubar">
        <li role="none">
          <a href={resolveHref('#hero')} class={`nav-item ${isHome ? 'active' : ''}`} role="menuitem">
            <span class="nav-label">Home</span>
            {isHome && <span class="active-sparkle" aria-hidden="true">✦</span>}
          </a>
        </li>
        <li role="none">
          <a href={resolveHref('#about')} class="nav-item" role="menuitem">
            <span class="nav-label">About</span>
          </a>
        </li>

        <!-- Leadership & Sacred Ethos Dropdown -->
        <li role="none" class="nav-dropdown-wrapper">
          <button 
            type="button" 
            class={`nav-item dropdown-trigger ${currentPath.startsWith('/team') || currentPath.startsWith('/history') || currentPath.startsWith('/inspiration') ? 'active' : ''}`}
            aria-haspopup="true"
            aria-expanded="false"
            id="leadership-dropdown-btn"
          >
            <span class="nav-label">Leadership</span>
            <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="m6 9 6 6 6-6"/>
            </svg>
            {(currentPath.startsWith('/team') || currentPath.startsWith('/history') || currentPath.startsWith('/inspiration')) && (
              <span class="active-sparkle" aria-hidden="true">✦</span>
            )}
          </button>
          
          <div class="nav-dropdown-menu" role="menu" aria-labelledby="leadership-dropdown-btn">
            <div class="dropdown-header-callout">
              <span class="callout-motto">Leading with Grace • Serving with Integrity</span>
              <span class="callout-sub">District 306 C2 • Chartered 2022</span>
            </div>
            
            <a href="/team" class={`dropdown-item ${currentPath.startsWith('/team') ? 'active' : ''}`} role="menuitem">
              <div class="dp-icon-box icon-iris">
                <span class="dp-icon">✦</span>
              </div>
              <div class="dp-text">
                <span class="dp-title">Our Full Team</span>
                <span class="dp-desc">2026 / 2027 Executive Board & Cabinet</span>
              </div>
            </a>

            <a href="/history/leaders" class={`dropdown-item ${currentPath.startsWith('/history/leaders') ? 'active' : ''}`} role="menuitem">
              <div class="dp-icon-box icon-gold">
                <span class="dp-icon">⚜</span>
              </div>
              <div class="dp-text">
                <span class="dp-title">Former Leaders</span>
                <span class="dp-desc">Historical Cabinets (2022–2026)</span>
              </div>
            </a>

            <a href="/inspiration" class={`dropdown-item ${currentPath.startsWith('/inspiration') ? 'active' : ''}`} role="menuitem">
              <div class="dp-icon-box icon-bloom">
                <span class="dp-icon">🌸</span>
              </div>
              <div class="dp-text">
                <span class="dp-title">Source of Inspiration</span>
                <span class="dp-desc">Founding Ethos & Living Legacy</span>
              </div>
            </a>

            <a href="/history/awards" class={`dropdown-item ${currentPath.startsWith('/history/awards') ? 'active' : ''}`} role="menuitem">
              <div class="dp-icon-box icon-award">
                <span class="dp-icon">🏆</span>
              </div>
              <div class="dp-text">
                <span class="dp-title">Club Awards</span>
                <span class="dp-desc">District Honours & Distinctions</span>
              </div>
            </a>
          </div>
        </li>

        <li role="none">
          <a href="/projects" class={`nav-item ${currentPath.startsWith('/projects') ? 'active' : ''}`} role="menuitem">
            <span class="nav-label">Projects</span>
            {currentPath.startsWith('/projects') && <span class="active-sparkle" aria-hidden="true">✦</span>}
          </a>
        </li>
        <li role="none">
          <a href="/gallery" class={`nav-item ${currentPath.startsWith('/gallery') ? 'active' : ''}`} role="menuitem">
            <span class="nav-label">Gallery</span>
            {currentPath.startsWith('/gallery') && <span class="active-sparkle" aria-hidden="true">✦</span>}
          </a>
        </li>
        <li role="none">
          <a href="/newsletter" class={`nav-item ${currentPath.startsWith('/newsletter') ? 'active' : ''}`} role="menuitem">
            <span class="nav-label">Newsletter</span>
            {currentPath.startsWith('/newsletter') && <span class="active-sparkle" aria-hidden="true">✦</span>}
          </a>
        </li>
      </ul>

      <!-- Desktop Action Suite -->
      <div class="nav-actions">
        <!-- Replay Bloom Intro Trigger (Crystal Floral Pill) -->
        <button 
          id="replay-bloom-btn" 
          class="replay-pill" 
          type="button" 
          title="Replay cinematic flower bloom intro"
          aria-label="Replay cinematic flower bloom"
        >
          <span class="replay-icon" aria-hidden="true">🌸</span>
          <span class="replay-label">Replay Bloom</span>
        </button>

        <!-- Imperial Iris & Earth Jewel CTA Button -->
        <a href={resolveHref('#join')} class="nav-cta-jewel">
          <span class="cta-sheen" aria-hidden="true"></span>
          <span class="cta-text">Join Us</span>
          <span class="cta-sparkle" aria-hidden="true">✦</span>
        </a>

        <!-- Mobile Menu Toggle Button (Luxury Morphing Jewel) -->
        <button 
          id="mobile-nav-toggle" 
          class="mobile-toggle" 
          type="button" 
          aria-expanded="false" 
          aria-controls="mobile-cinematic-drawer"
          aria-label="Toggle navigation menu"
        >
          <div class="toggle-bezel">
            <span class="menu-bar bar-top"></span>
            <span class="menu-bar-dot"></span>
            <span class="menu-bar bar-bot"></span>
          </div>
        </button>
      </div>
    </nav>
  </div>

  <!-- Full-Screen Nocturnal Conservatory Mobile Drawer -->
  <div id="mobile-cinematic-drawer" class="mobile-drawer-overlay" aria-hidden="true">
    <!-- Atmospheric Environmental Nebulae -->
    <div class="celestial-nebula earth-azure" aria-hidden="true"></div>
    <div class="celestial-nebula iris-bloom" aria-hidden="true"></div>
    <div class="celestial-nebula gold-starlight" aria-hidden="true"></div>

    <!-- Floating Stardust Decor -->
    <div class="stardust-container" aria-hidden="true">
      <span class="star-particle star-1">✦</span>
      <span class="star-particle star-2">✧</span>
      <span class="star-particle star-3">✦</span>
      <span class="star-particle star-4">·</span>
      <span class="star-particle star-5">✧</span>
    </div>

    <div class="mobile-drawer-scroll">
      <div class="mobile-drawer-inner">
        <!-- Drawer Header with illuminated brand mark & close button -->
        <div class="drawer-header">
          <div class="drawer-brand">
            <div class="drawer-crest-mini">
              <img src="/crest.webp" alt="Leo Crest" width="34" height="34" loading="lazy" />
            </div>
            <div class="drawer-brand-text">
              <span class="d-brand-title">LEO CLUB OF EIC</span>
              <span class="d-brand-sub">Leading with Grace • Colombo 7</span>
            </div>
          </div>
          
          <button id="mobile-drawer-close" class="drawer-close-btn" type="button" aria-label="Close navigation menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Editorial Staggered Link Stream -->
        <nav class="drawer-nav-flow" aria-label="Mobile Navigation">
          <ul class="drawer-links-list">
            <li class="drawer-nav-item" style="--i: 1">
              <a href={resolveHref('#hero')} class={`drawer-link ${isHome ? 'active' : ''}`}>
                <span class="link-idx">01</span>
                <span class="link-title">Home</span>
                <span class="link-arrow">→</span>
              </a>
            </li>

            <li class="drawer-nav-item" style="--i: 2">
              <a href={resolveHref('#about')} class="drawer-link">
                <span class="link-idx">02</span>
                <span class="link-title">About Us</span>
                <span class="link-arrow">→</span>
              </a>
            </li>

            <!-- Accordion: Leadership & Living Ethos -->
            <li class="drawer-nav-item drawer-accordion-wrapper" style="--i: 3">
              <button 
                type="button" 
                class="drawer-link drawer-accordion-trigger" 
                id="mobile-leadership-trigger"
                aria-expanded="false"
                aria-controls="mobile-leadership-sub"
              >
                <span class="link-idx">03</span>
                <span class="link-title">Leadership & Ethos</span>
                <span class="accordion-chevron" aria-hidden="true">▾</span>
              </button>

              <div id="mobile-leadership-sub" class="drawer-accordion-content" aria-hidden="true">
                <div class="accordion-inner">
                  <a href="/team" class={`acc-item ${currentPath.startsWith('/team') ? 'active' : ''}`}>
                    <span class="acc-badge">✦</span>
                    <div class="acc-text">
                      <span class="acc-name">Our Full Team</span>
                      <span class="acc-meta">2026/27 Cabinet</span>
                    </div>
                  </a>
                  <a href="/history/leaders" class={`acc-item ${currentPath.startsWith('/history/leaders') ? 'active' : ''}`}>
                    <span class="acc-badge">⚜</span>
                    <div class="acc-text">
                      <span class="acc-name">Former Leaders</span>
                      <span class="acc-meta">Historical Roster</span>
                    </div>
                  </a>
                  <a href="/inspiration" class={`acc-item ${currentPath.startsWith('/inspiration') ? 'active' : ''}`}>
                    <span class="acc-badge">🌸</span>
                    <div class="acc-text">
                      <span class="acc-name">Source of Inspiration</span>
                      <span class="acc-meta">Living Legacy</span>
                    </div>
                  </a>
                  <a href="/history/awards" class={`acc-item ${currentPath.startsWith('/history/awards') ? 'active' : ''}`}>
                    <span class="acc-badge">🏆</span>
                    <div class="acc-text">
                      <span class="acc-name">Club Awards</span>
                      <span class="acc-meta">District Distinctions</span>
                    </div>
                  </a>
                </div>
              </div>
            </li>

            <li class="drawer-nav-item" style="--i: 4">
              <a href="/projects" class={`drawer-link ${currentPath.startsWith('/projects') ? 'active' : ''}`}>
                <span class="link-idx">04</span>
                <span class="link-title">Initiatives & Projects</span>
                <span class="link-arrow">→</span>
              </a>
            </li>

            <li class="drawer-nav-item" style="--i: 5">
              <a href="/gallery" class={`drawer-link ${currentPath.startsWith('/gallery') ? 'active' : ''}`}>
                <span class="link-idx">05</span>
                <span class="link-title">Photographic Gallery</span>
                <span class="link-arrow">→</span>
              </a>
            </li>

            <li class="drawer-nav-item" style="--i: 6">
              <a href="/newsletter" class={`drawer-link ${currentPath.startsWith('/newsletter') ? 'active' : ''}`}>
                <span class="link-idx">06</span>
                <span class="link-title">Dispatches & Newsletter</span>
                <span class="link-arrow">→</span>
              </a>
            </li>
          </ul>
        </nav>

        <!-- Drawer Action Suite -->
        <div class="drawer-action-hub">
          <button id="mobile-replay-bloom-btn" class="drawer-btn-secondary" type="button">
            <span class="d-btn-icon">🌸</span>
            <span>Replay Cinematic Bloom Intro</span>
          </button>
          
          <a href={resolveHref('#join')} class="drawer-btn-primary">
            <span>Join Leo Club of EIC</span>
            <span class="d-btn-arrow">→</span>
          </a>
        </div>

        <!-- Drawer District Seal -->
        <div class="drawer-footer-seal">
          <div class="seal-line"></div>
          <p class="seal-text">
            <span>✦ DISTRICT 306 C2</span>
            <span class="seal-sep">•</span>
            <span>CHARTERED 2022</span>
            <span class="seal-sep">•</span>
            <span>EMPOWERING YOUTH ✦</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* =========================================================================
     Floating Header Wrapper & Structural Flow
     ========================================================================= */
  .nav-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    box-sizing: border-box;
    z-index: 1000;
    padding-top: clamp(0.75rem, 1.8vw, 1.25rem);
    padding-inline: var(--gutter);
    pointer-events: none;
    transition: transform var(--duration-normal) var(--ease-apple);
  }

  .nav-container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    display: flex;
    justify-content: center;
  }

  /* =========================================================================
     Cinematic Nav Island: Celestial Garden Crystal Capsule
     ========================================================================= */
  .nav-island {
    position: relative;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.75rem, 2vw, 2.25rem);
    width: 100%;
    max-width: 1160px;
    height: 68px;
    padding: 0.45rem 0.75rem 0.45rem 0.95rem;
    border-radius: var(--radius-full);
    
    /* Ethereal luminous glass body blending Azure (left) and Iris (right) */
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.94) 0%,
      rgba(240, 246, 255, 0.9) 28%,
      rgba(252, 248, 255, 0.94) 65%,
      rgba(255, 252, 244, 0.92) 100%
    );
    backdrop-filter: blur(32px) saturate(220%);
    -webkit-backdrop-filter: blur(32px) saturate(220%);
    
    /* Ceremonial Gold Hairline Border */
    border: 1.5px solid rgba(194, 155, 77, 0.45);
    
    /* Atmospheric Multi-Glow: Earth Azure + Iris Violet + Champagne Gold */
    box-shadow: 
      0 16px 44px -10px rgba(33, 22, 56, 0.16),
      0 0 24px -2px rgba(62, 132, 194, 0.22),
      0 0 32px -2px rgba(122, 87, 184, 0.24),
      inset 0 1px 1px #FFFFFF,
      inset 0 -1px 1px rgba(194, 155, 77, 0.22);
    
    transition: 
      background var(--duration-normal) var(--ease-apple),
      box-shadow var(--duration-normal) var(--ease-apple),
      border-color var(--duration-normal) var(--ease-apple),
      transform var(--duration-normal) var(--ease-apple);
  }

  /* Embedded Watercolor Iris Petal Ornament (Subtle botanical watermark on glass) */
  .nav-botanical-whisper {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 80px;
    width: 120px;
    height: 100%;
    background-image: url('/botanical/iris-blossom-br.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.16;
    mix-blend-mode: multiply;
    pointer-events: none;
    border-radius: inherit;
    transition: opacity var(--duration-normal) ease;
  }

  /* Top Shimmer Line Reflecting Sunlight */
  .nav-island::after {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(
      90deg, 
      transparent 0%, 
      rgba(62, 132, 194, 0.6) 25%, 
      rgba(194, 155, 77, 0.85) 50%, 
      rgba(155, 121, 222, 0.6) 75%, 
      transparent 100%
    );
    pointer-events: none;
  }

  /* Scrolled State Elevation */
  :global(.is-scrolled) .nav-island {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.97) 0%,
      rgba(240, 246, 255, 0.94) 30%,
      rgba(252, 248, 255, 0.97) 70%,
      rgba(255, 252, 244, 0.95) 100%
    );
    border-color: rgba(194, 155, 77, 0.65);
    box-shadow: 
      0 20px 52px -10px rgba(33, 22, 56, 0.22),
      0 0 28px -2px rgba(62, 132, 194, 0.28),
      0 0 38px -2px rgba(194, 155, 77, 0.26);
    transform: translateY(-2px);
  }

  /* =========================================================================
     Brand Crest Medallion with Dual Orbital Rings & Living Artwork
     ========================================================================= */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    flex-shrink: 0;
    outline: none;
    z-index: 2;
  }

  .crest-frame {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-normal) var(--ease-apple);
    flex-shrink: 0;
  }

  /* Ambient Backlight Halo: Earth Azure & Iris Bloom */
  .crest-glow-halo {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: radial-gradient(
      circle, 
      rgba(62, 132, 194, 0.38) 0%, 
      rgba(122, 87, 184, 0.3) 55%, 
      transparent 100%
    );
    filter: blur(5px);
    opacity: 0.85;
    pointer-events: none;
    transition: opacity var(--duration-normal) ease;
  }

  /* Outer Laurel Gold Bezel */
  .ring-laurel-gold {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1.8px;
    background: linear-gradient(135deg, #F4E8C9 0%, #C29B4D 50%, #9F7B2F 100%);
    box-shadow: 0 2px 12px rgba(194, 155, 77, 0.35);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Inner Earth Azure Orbital Ring */
  .ring-earth-blue {
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    border: 1.2px dashed rgba(62, 132, 194, 0.6);
    pointer-events: none;
    animation: slowOrbitSpin 28s linear infinite;
  }

  @keyframes slowOrbitSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .brand-crest {
    width: 38px;
    height: 38px;
    object-fit: cover;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    background: #FFFFFF;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
  }

  .brand-link:hover .crest-frame {
    transform: scale(1.08) rotate(3deg);
  }

  .brand-link:hover .crest-glow-halo {
    opacity: 1;
    filter: blur(7px);
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--c-text-primary);
    transition: color var(--duration-fast) ease;
  }

  .brand-link:hover .brand-title {
    color: var(--c-iris-deep);
  }

  /* Subtitle displaying official club motto in gold serif */
  .brand-subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--c-gold-deep);
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 1px;
  }

  .sub-dot {
    font-size: 0.52rem;
    color: var(--c-gold);
    opacity: 0.85;
    font-style: normal;
  }

  /* =========================================================================
     Desktop Nav Links: Botanical Hover & Active Capsules
     ========================================================================= */
  .nav-links {
    display: none;
    list-style: none;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    z-index: 2;
  }

  @media (min-width: 930px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--c-text-secondary);
    padding: 0.48rem 0.85rem;
    white-space: nowrap;
    border-radius: var(--radius-full);
    text-decoration: none;
    border: 1px solid transparent;
    transition: 
      color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .nav-item:hover {
    color: var(--c-iris-deep);
    background: rgba(122, 87, 184, 0.09);
    border-color: rgba(194, 155, 77, 0.3);
    transform: translateY(-1px);
  }

  .nav-item.active {
    color: var(--c-iris-deep);
    font-weight: 700;
    background: linear-gradient(135deg, rgba(122, 87, 184, 0.16) 0%, rgba(62, 132, 194, 0.12) 100%);
    border-color: rgba(194, 155, 77, 0.55);
    box-shadow: 
      0 2px 10px rgba(122, 87, 184, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
  }

  .active-sparkle {
    font-size: 0.65rem;
    color: var(--c-gold);
    line-height: 1;
    animation: gentlePulse 2.4s ease-in-out infinite;
  }

  @keyframes gentlePulse {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  /* =========================================================================
     Leadership & Sacred Ethos Dropdown Flyout
     ========================================================================= */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .dropdown-trigger {
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
  }

  .dropdown-chevron {
    transition: transform var(--duration-fast) ease;
    opacity: 0.75;
  }

  .nav-dropdown-wrapper:hover .dropdown-chevron,
  .nav-dropdown-wrapper:focus-within .dropdown-chevron,
