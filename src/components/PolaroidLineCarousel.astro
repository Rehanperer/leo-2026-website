---
/**
 * PolaroidLineCarousel.astro
 * Hanging Polaroid Carousel with real-time pendulum physics and sagging string.
 * Native Astro + vanilla TypeScript client runtime for 120fps GPU performance,
 * zero React hydration overhead, and full touch + wheel + keyboard support.
 */

export interface SlideItem {
  id?: number | string;
  image: string;
  title: string;
  caption?: string;
  category?: string;
  alt?: string;
}

export interface Props {
  slides?: SlideItem[];
  height?: string;
  cardWidth?: number;
  sag?: number;
  swing?: number;
  autoplay?: number;
  className?: string;
}

const {
  slides = [],
  height = "100vh",
  cardWidth = 310,
  sag = 46,
  swing = 1,
  autoplay = 4500,
  className = "",
} = Astro.props;

const n = slides.length;
---

<div
  class:list={["pl-root", className]}
  id="polaroid-carousel"
  style={`height: ${height}; --pl-cw: ${cardWidth}px;`}
  role="region"
  aria-roledescription="carousel"
  aria-label="Leo Club Photographic Carousel"
  tabindex="0"
  data-slides-count={n}
  data-card-width={cardWidth}
  data-sag={sag}
  data-swing={swing}
  data-autoplay={autoplay}
>
  <!-- Ambient Deep Obsidian Vignette Background -->
  <div class="pl-ambient-bg" aria-hidden="true">
    <div class="pl-glow-top"></div>
    <div class="pl-glow-center"></div>
    <div class="pl-vignette-overlay"></div>
  </div>

  <!-- SVG Sagging Hanging Twine -->
  <svg class="pl-string-svg" aria-hidden="true">
    <path id="pl-string-path" class="pl-string-line" fill="none" stroke="#9d8c76" stroke-width="1.8" stroke-linecap="round" />
  </svg>

  <!-- Hanging Polaroid Cards Container -->
  <div class="pl-cards-track" id="pl-cards-track">
    {slides.map((slide, i) => (
      <div
        class="pl-card"
        data-i={i}
        data-on={i === 0 ? "1" : "0"}
        id={`pl-card-${i}`}
        aria-hidden={i === 0 ? undefined : "true"}
      >
        <div class="pl-print" role="button" tabindex="0" aria-label={`View ${slide.title}`}>
          <div class="pl-shot">
            <img
              src={slide.image}
              alt={slide.alt || slide.title}
              loading={i < 5 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={i === 0 ? "high" : "auto"}
              draggable="false"
            />
            <div class="pl-lens-glare" aria-hidden="true"></div>
            <div class="pl-zoom-hint" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </div>
          </div>
          <div class="pl-note" title={slide.title}>
            <span>{slide.title}</span>
          </div>
        </div>

        <!-- Clothespin Wooden Peg clamped over twine -->
        <div class="pl-peg" aria-hidden="true">
          <div class="pl-peg-slot"></div>
          <div class="pl-peg-spring"></div>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Details & Navigation Bar -->
  <div class="pl-bar" id="pl-bar">
    <div class="pl-cap" id="pl-cap" aria-live="polite">
      {slides.length > 0 && (
        <>
          <div class="pl-tag-wrap">
            {slides[0].category && (
              <span class="pl-category-pill" id="pl-active-category">{slides[0].category}</span>
            )}
            <span class="pl-click-hint" id="pl-click-hint">Click photo to zoom • Scroll / Drag to swing</span>
          </div>
          <h2 class="pl-title" id="pl-active-title">{slides[0].title}</h2>
          {slides[0].caption && (
            <p class="pl-sub" id="pl-active-caption">{slides[0].caption}</p>
          )}
        </>
      )}
    </div>

    <div class="pl-controls-group">
      <!-- Cruise Auto-play Toggle -->
      <button type="button" class="pl-cruise-btn" id="pl-cruise-btn" aria-label="Toggle autoplay" title="Autoplay slideshow">
        <span class="pl-cruise-dot" id="pl-cruise-dot"></span>
        <span class="pl-cruise-text" id="pl-cruise-text">Cruise: On</span>
      </button>

      <!-- Counter -->
      <span class="pl-count" aria-hidden="true" id="pl-count-display">
        <b id="pl-active-num">01</b> / <span id="pl-total-num">{String(n).padStart(2, "0")}</span>
      </span>

      <!-- Step Navigation Buttons -->
      <div class="pl-nav-arrows">
        <button type="button" class="pl-btn" id="pl-prev-btn" aria-label="Previous photo">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="pl-btn" id="pl-next-btn" aria-label="Next photo">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Screen Reader Live Status -->
  <div class="pl-sr" id="pl-sr-status" aria-live="polite">
    Photo 1 of {n}: {slides[0]?.title}
  </div>

  <!-- Fullscreen Lightbox Modal -->
  <dialog class="pl-lightbox" id="pl-lightbox" aria-modal="true" aria-label="Photo Inspector">
    <div class="pl-lightbox-backdrop" id="pl-lightbox-backdrop"></div>
    <div class="pl-lightbox-content">
      <button type="button" class="pl-lightbox-close" id="pl-lightbox-close" aria-label="Close Inspector">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="pl-lightbox-frame">
        <img src="" alt="" id="pl-lightbox-img" class="pl-lightbox-img" />
        <div class="pl-lightbox-caption">
          <span class="pl-lightbox-cat" id="pl-lightbox-cat"></span>
          <h3 class="pl-lightbox-title" id="pl-lightbox-title"></h3>
          <p class="pl-lightbox-desc" id="pl-lightbox-desc"></p>
        </div>
      </div>
    </div>
  </dialog>
</div>

<!-- Embedded JSON Slide Data for Client Script -->
<script id="pl-slides-json" type="application/json" set:html={JSON.stringify(slides)}></script>

<style>
  /* ---------------- Root Container ---------------- */
  .pl-root {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: #090a0f;
    color: #f5f3ef;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none; /* Let pointer handler take complete physics control */
    outline: none;
    cursor: grab;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .pl-root[data-drag="1"] {
    cursor: grabbing;
  }

  /* ---------------- Ambient Luxury Background ---------------- */
  .pl-ambient-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .pl-glow-top {
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 90vw;
    height: 380px;
    background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.08) 0%, rgba(13, 20, 36, 0) 70%);
    filter: blur(40px);
  }

  .pl-glow-center {
    position: absolute;
    bottom: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 480px;
    background: radial-gradient(ellipse at center, rgba(25, 33, 56, 0.28) 0%, rgba(9, 10, 15, 0) 75%);
    filter: blur(50px);
  }

  .pl-vignette-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(5, 6, 10, 0.7) 100%);
  }

  /* ---------------- SVG Sagging Hanging Twine ---------------- */
  .pl-string-svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 5;
  }

  .pl-string-line {
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.7));
  }

  /* ---------------- Polaroid Cards Track ---------------- */
  .pl-cards-track {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 8;
  }

  .pl-card {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--pl-cw);
    transform-origin: 50% 0;
    will-change: transform;
    cursor: inherit;
    pointer-events: auto;
  }

  /* ---------------- Polaroid Print ---------------- */
  .pl-print {
    margin-top: 10px;
    background: #fbf9f5;
    padding: 10px 10px 0;
    border-radius: 2px;
    box-shadow:
      0 2px 5px rgba(0, 0, 0, 0.2),
      0 18px 36px -12px rgba(0, 0, 0, 0.65),
      0 0 1px rgba(0, 0, 0, 0.4);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.45s ease,
      box-shadow 0.45s ease,
      opacity 0.45s ease;
    cursor: pointer;
    outline: none;
  }

  .pl-print:focus-visible {
    box-shadow: 0 0 0 3px #d4af37, 0 18px 36px -12px rgba(0, 0, 0, 0.65);
  }

  /* Inactive Cards: slightly scaled down, dimmed, desaturated */
  .pl-card[data-on="0"] .pl-print {
    transform: scale(0.91);
    filter: saturate(0.72) brightness(0.92);
    opacity: 0.82;
  }

  /* Active Center Card: elevated, crisp, ambient golden backlight */
  .pl-card[data-on="1"] .pl-print {
    transform: scale(1.03);
    filter: saturate(1.05) brightness(1.02);
    opacity: 1;
    box-shadow:
      0 4px 10px rgba(0, 0, 0, 0.25),
      0 26px 54px -14px rgba(0, 0, 0, 0.8),
      0 0 32px rgba(212, 175, 55, 0.15);
  }

  /* Hover effect on cards */
  .pl-card:hover .pl-print {
    filter: saturate(1) brightness(1);
    opacity: 1;
  }

  /* ---------------- Photo Shot Frame ---------------- */
  .pl-shot {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #1e2029;
    border-radius: 1px;
  }

  .pl-shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
    pointer-events: none;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pl-card[data-on="1"]:hover .pl-shot img {
    transform: scale(1.04);
  }

  .pl-lens-glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 45%);
    pointer-events: none;
  }

  .pl-zoom-hint {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(10, 12, 18, 0.75);
    backdrop-filter: blur(6px);
    color: #e5cca0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  .pl-card[data-on="1"] .pl-zoom-hint {
    opacity: 0.85;
    transform: scale(1);
  }

  .pl-card[data-on="1"]:hover .pl-zoom-hint {
    opacity: 1;
    background: rgba(212, 175, 55, 0.9);
    color: #0b0d14;
  }

  /* ---------------- Handwritten / Serif Note ---------------- */
  .pl-note {
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 8px;
    font: italic 400 clamp(13px, 1.3vw, 15px)/1.1 ui-serif, Georgia, 'Playfair Display', serif;
    color: #2e2b26;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.01em;
  }

  /* ---------------- Wooden Clothespin Peg ---------------- */
  .pl-peg {
    position: absolute;
    left: 50%;
    top: -8px;
    width: 12px;
    height: 32px;
    margin-left: -6px;
    border-radius: 2px 2px 1px 1px;
    background: linear-gradient(90deg, #c49f6f 0%, #ecd4aa 38%, #f2dec0 55%, #b18751 100%);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.45);
    z-index: 12;
    pointer-events: none;
  }

  /* Peg Metal Spring Ring */
  .pl-peg-spring {
    position: absolute;
    left: -0.5px;
    right: -0.5px;
    top: 11px;
    height: 3.5px;
    background: linear-gradient(90deg, #615647, #a89c89 50%, #524738);
    border-radius: 1px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  /* Peg Bottom Clamping Split */
  .pl-peg-slot {
    position: absolute;
    left: 5px;
    bottom: 0;
    width: 2px;
    height: 12px;
    background: rgba(45, 30, 15, 0.7);
    border-radius: 1px 1px 0 0;
  }

  /* ---------------- Bottom Details & Navigation Bar ---------------- */
  .pl-bar {
    position: absolute;
    left: clamp(16px, 4.5vw, 64px);
    right: clamp(16px, 4.5vw, 64px);
    bottom: clamp(20px, 4vh, 48px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    cursor: default;
    z-index: 25;
    pointer-events: auto;
  }

  .pl-cap {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding-bottom: 2px;
  }

  .pl-tag-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .pl-category-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 9999px;
    background: rgba(212, 175, 55, 0.14);
    border: 1px solid rgba(212, 175, 55, 0.35);
    color: #e5cca0;
    font: 600 11px/1.2 ui-sans-serif, system-ui, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pl-click-hint {
    font: 400 11px/1.2 ui-sans-serif, system-ui, sans-serif;
    color: rgba(245, 243, 239, 0.45);
    letter-spacing: 0.04em;
  }

  .pl-title {
    margin: 0;
    font: 500 clamp(20px, 2.6vw, 32px)/1.18 ui-serif, Georgia, 'Playfair Display', serif;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .pl-sub {
    margin: 4px 0 0;
    font: 400 clamp(12px, 1.2vw, 14px)/1.4 ui-sans-serif, system-ui, sans-serif;
    color: rgba(245, 243, 239, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------------- Navigation & Controls Group ---------------- */
  .pl-controls-group {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
    flex-shrink: 0;
  }

  /* Cruise Auto-play Button */
  .pl-cruise-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 9999px;
    border: 1px solid rgba(245, 243, 239, 0.16);
    background: rgba(20, 23, 33, 0.7);
    backdrop-filter: blur(8px);
    color: rgba(245, 243, 239, 0.85);
    font: 500 12px/1 ui-sans-serif, system-ui, sans-serif;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .pl-cruise-btn:hover {
    background: rgba(212, 175, 55, 0.15);
    border-color: rgba(212, 175, 55, 0.4);
    color: #ffffff;
  }

  .pl-cruise-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  .pl-cruise-btn.paused .pl-cruise-dot {
    background: #f59e0b;
    box-shadow: 0 0 6px #f59e0b;
  }

  /* Slide Counter */
  .pl-count {
    font: 500 13px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.14em;
    color: rgba(245, 243, 239, 0.5);
  }

  .pl-count b {
    color: #e5cca0;
    font-weight: 600;
  }

  /* Step Arrow Buttons */
  .pl-nav-arrows {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pl-btn {
    appearance: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(245, 243, 239, 0.2);
    background: rgba(20, 23, 33, 0.7);
    backdrop-filter: blur(8px);
    color: #f5f3ef;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pl-btn:hover {
    background: #f5f3ef;
    border-color: #f5f3ef;
    color: #0a0b10;
    transform: scale(1.06);
  }

  .pl-btn:active {
    transform: scale(0.96);
  }

  .pl-btn:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 2px;
  }

  /* Screen Reader Hidden */
  .pl-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------------- Lightbox Dialog ---------------- */
  .pl-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    border: none;
    padding: 0;
    margin: 0;
    background: transparent;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .pl-lightbox[open] {
    display: flex;
  }

  .pl-lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 7, 12, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .pl-lightbox-content {
    position: relative;
    z-index: 2;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pl-lightbox-close {
    position: absolute;
    top: -50px;
    right: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(20, 24, 34, 0.8);
    color: #ffffff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pl-lightbox-close:hover {
    background: #ffffff;
    color: #0b0c10;
    transform: scale(1.08);
  }

  .pl-lightbox-frame {
    background: #faf8f5;
    padding: 14px 14px 18px;
    border-radius: 4px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(212, 175, 55, 0.2);
    max-width: 720px;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .pl-lightbox-img {
    width: 100%;
    max-height: 65vh;
    object-fit: contain;
    border-radius: 2px;
    background: #11131a;
  }

  .pl-lightbox-caption {
    margin-top: 14px;
    text-align: center;
  }

  .pl-lightbox-cat {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 9999px;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.35);
    color: #b58d51;
    font: 600 10px/1.2 ui-sans-serif, system-ui, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .pl-lightbox-title {
    margin: 0;
    font: 600 20px/1.2 ui-serif, Georgia, serif;
    color: #1a1917;
  }

  .pl-lightbox-desc {
    margin: 4px 0 0;
    font: 400 13px/1.4 ui-sans-serif, system-ui, sans-serif;
    color: #605c54;
  }

  /* ---------------- Responsive Adaptations ---------------- */
  @media (max-width: 768px) {
    .pl-bar {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      bottom: 24px;
      left: 20px;
      right: 20px;
    }

    .pl-controls-group {
      justify-content: space-between;
      width: 100%;
    }

    .pl-title {
      font-size: 20px;
    }

    .pl-sub {
      font-size: 12px;
    }

    .pl-btn {
      width: 40px;
      height: 40px;
    }

    .pl-cruise-btn {
      padding: 6px 12px;
      font-size: 11px;
    }

    .pl-lightbox-close {
      top: -44px;
      right: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-print {
      transition: none;
    }
  }
</style>

<script>
  // Client-side TypeScript Runtime for Physics and Interaction
  interface SlideData {
    image: string;
    title: string;
    caption?: string;
    category?: string;
    alt?: string;
  }

  const initPolaroidCarousel = () => {
    const root = document.getElementById("polaroid-carousel") as HTMLDivElement | null;
    if (!root) return;

    const slidesScript = document.getElementById("pl-slides-json") as HTMLScriptElement | null;
    const slides: SlideData[] = slidesScript ? JSON.parse(slidesScript.textContent || "[]") : [];
    const n = slides.length;
    if (n === 0) return;

    // Elements
    const pathEl = document.getElementById("pl-string-path") as SVGPathElement | null;
    const cardEls: (HTMLDivElement | null)[] = Array.from({ length: n }, (_, i) =>
      document.getElementById(`pl-card-${i}`) as HTMLDivElement | null
    );

    // Caption & Control Elements
    const activeNumEl = document.getElementById("pl-active-num");
    const activeTitleEl = document.getElementById("pl-active-title");
    const activeSubEl = document.getElementById("pl-active-caption");
    const activeCatEl = document.getElementById("pl-active-category");
    const srStatusEl = document.getElementById("pl-sr-status");
    const prevBtn = document.getElementById("pl-prev-btn");
    const nextBtn = document.getElementById("pl-next-btn");
    const cruiseBtn = document.getElementById("pl-cruise-btn");
    const cruiseText = document.getElementById("pl-cruise-text");

    // Lightbox Elements
    const lightbox = document.getElementById("pl-lightbox") as HTMLDialogElement | null;
    const lightboxBackdrop = document.getElementById("pl-lightbox-backdrop");
    const lightboxClose = document.getElementById("pl-lightbox-close");
    const lightboxImg = document.getElementById("pl-lightbox-img") as HTMLImageElement | null;
    const lightboxTitle = document.getElementById("pl-lightbox-title");
    const lightboxDesc = document.getElementById("pl-lightbox-desc");
    const lightboxCat = document.getElementById("pl-lightbox-cat");

    // Config from data attributes
    const cardWidthAttr = Number(root.dataset.cardWidth || 310);
    const sagAttr = Number(root.dataset.sag || 46);
    const swingGain = Number(root.dataset.swing || 1);
    const autoplayInterval = Number(root.dataset.autoplay || 4500);

    // Dynamic Sizing State
    const size = {
      w: 1200,
      h: 800,
      cw: cardWidthAttr,
      sag: sagAttr,
      spacing: cardWidthAttr * 1.08,
    };

    // Physics Simulation State
    const sim = {
      off: 0,
      vel: 0,
      target: 0,
      a: new Float64Array(n),
      w: new Float64Array(n),
    };

    let activeIndex = 0;
    let autoplayActive = true;
    let lastUserTouch = performance.now();
    let dragData: { x: number; off: number; lx: number; lt: number; v: number; moved: boolean } | null = null;
    let wheelTimeout: any = null;

    // Mathematics Helpers
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const pad2 = (num: number) => (num < 10 ? "0" + num : String(num));

    const stringY = (x: number, w: number, y0: number, sag: number): number => {
      const t = clamp(x / w, 0, 1);
      return y0 + 4 * sag * t * (1 - t);
    };

    const springStep = (x: number, v: number, target: number, dt: number, k = 70): [number, number] => {
      const c = 2 * Math.sqrt(k);
      const nv = v + (k * (target - x) - c * v) * dt;
      return [x + nv * dt, nv];
    };

    const swingStep = (a: number, w: number, lineVel: number, dt: number, gain: number): [number, number] => {
      // Natural pendulum physics: gravity restores toward 0, friction damps, lineVel imparts inertial tilt
      const nw = w + (-38 * a - 4.2 * w + lineVel * 0.0034 * gain) * dt;
      return [clamp(a + nw * dt, -0.65, 0.65), nw];
    };

    const nearestAt = (off: number, spacing: number, total: number): number => {
      return clamp(Math.round(off / spacing), 0, Math.max(0, total - 1));
    };

    // Navigate to Index
    const goTo = (index: number) => {
      const safeIndex = clamp(index, 0, n - 1);
      sim.target = safeIndex * size.spacing;
    };

    // Update Bottom Caption & Meta
    const updateActiveMeta = (idx: number) => {
      const s = slides[idx];
      if (!s) return;

      if (activeNumEl) activeNumEl.textContent = pad2(idx + 1);
      if (activeTitleEl) activeTitleEl.textContent = s.title;
      if (activeSubEl) activeSubEl.textContent = s.caption || "";
      if (activeCatEl) {
        activeCatEl.textContent = s.category || "";
        activeCatEl.style.display = s.category ? "inline-block" : "none";
      }
      if (srStatusEl) {
        srStatusEl.textContent = `Photo ${idx + 1} of ${n}: ${s.title}`;
      }

      // Update active attribute on cards
      cardEls.forEach((card, i) => {
        if (!card) return;
        const isActive = i === idx;
        card.setAttribute("data-on", isActive ? "1" : "0");
        card.setAttribute("aria-hidden", isActive ? "false" : "true");
      });
    };

    // Open Lightbox for an item
    const openLightbox = (idx: number) => {
      const s = slides[idx];
      if (!s || !lightbox || !lightboxImg) return;

      lightboxImg.src = s.image;
      lightboxImg.alt = s.alt || s.title;
      if (lightboxTitle) lightboxTitle.textContent = s.title;
      if (lightboxDesc) lightboxDesc.textContent = s.caption || "";
      if (lightboxCat) {
        lightboxCat.textContent = s.category || "";
        lightboxCat.style.display = s.category ? "inline-block" : "none";
      }

      lightbox.showModal();
    };

    const closeLightbox = () => {
      if (lightbox && lightbox.open) {
        lightbox.close();
      }
    };

    // ResizeObserver for dynamic layout
    const ro = new ResizeObserver(() => {
      const r = root.getBoundingClientRect();
      // On narrow viewports (mobile phones), cards adapt gracefully
      const maxCardW = r.width < 500 ? r.width * 0.65 : (r.width < 800 ? r.width * 0.44 : cardWidthAttr);
      const cw = Math.round(Math.max(170, Math.min(maxCardW, r.height * 0.45)));
      const sag = Math.round(Math.max(24, Math.min(sagAttr, r.height * 0.07)));
      const spacing = cw * 1.08;

      size.w = r.width;
      size.h = r.height;
      size.cw = cw;
      size.sag = sag;
      size.spacing = spacing;

      root.style.setProperty("--pl-cw", `${cw}px`);

      // Keep target synchronized on resize
      sim.target = activeIndex * spacing;
      sim.off = activeIndex * spacing;
    });
    ro.observe(root);

    // Animation Render Loop
    let raf = 0;
    let prevTime = performance.now();
    let isVisible = true;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const renderFrame = (now: number) => {
      raf = 0;
      if (!isVisible) return;

      const dt = Math.min(0.033, (now - prevTime) / 1000);
      prevTime = now;

      const { w, h, cw, sag, spacing } = size;
      // String height Y0 adapts: starts gracefully below top navigation bar
      const y0 = w < 600 ? Math.max(82, h * 0.16) : Math.max(96, Math.min(140, h * 0.20));

      let lineVel: number;
      if (dragData && dragData.moved) {
        lineVel = dragData.v * 1000;
      } else {
        const before = sim.off;
        const [nextOff, nextVel] = springStep(sim.off, sim.vel, sim.target, dt);
        sim.off = nextOff;
        sim.vel = nextVel;
        lineVel = -(sim.off - before) / Math.max(dt, 1e-3);
      }

      const g = prefersReducedMotion ? 0 : swingGain;
      const near = nearestAt(sim.off, spacing, n);

      // Render all cards
      for (let i = 0; i < n; i++) {
        const el = cardEls[i];
        if (!el) continue;

        const x = w / 2 + i * spacing - sim.off;

        // Culling offscreen cards for pure 120fps performance
        if (x < -cw * 1.6 || x > w + cw * 1.6) {
          el.style.visibility = "hidden";
          continue;
        }

        el.style.visibility = "visible";

        let a = sim.a[i] || 0;
        let av = sim.w[i] || 0;
        const [nextA, nextAv] = swingStep(a, av, lineVel, dt, g);
        a = nextA;
        av = nextAv;

        // Subtle ambient breeze sway when resting
        if (g) {
          a += Math.sin(now / 1300 + i * 1.7) * 0.0009 * g;
        }

        sim.a[i] = a;
        sim.w[i] = av;

        const y = stringY(x, w, y0, sag);

        // Clothespin peg groove aligns directly on the string: translate to (y - 8px)
        el.style.transform = `translate3d(${(x - cw / 2).toFixed(1)}px, ${(y - 8).toFixed(1)}px, 0) rotate(${a.toFixed(4)}rad)`;
        el.style.zIndex = String(i === near ? n + 2 : n - Math.abs(i - near));
      }

      // Update SVG Sagging Twine
      if (pathEl) {
        pathEl.setAttribute(
          "d",
          `M 0 ${y0} Q ${w / 2} ${y0 + 2 * sag} ${w} ${y0}`
        );
      }

      // Trigger metadata update on card crossing
      if (near !== activeIndex) {
        activeIndex = near;
        updateActiveMeta(near);
      }

      raf = requestAnimationFrame(renderFrame);
    };

    // IntersectionObserver to preserve battery & GPU
    const io = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
      if (isVisible && !raf) {
        prevTime = performance.now();
        raf = requestAnimationFrame(renderFrame);
      }
    });
    io.observe(root);
    raf = requestAnimationFrame(renderFrame);

    // Autoplay Timer
    let autoplayTimer: any = null;
    const startAutoplay = () => {
      if (!autoplayInterval || n < 2) return;
      clearInterval(autoplayTimer);
      autoplayTimer = setInterval(() => {
        if (!autoplayActive || document.hidden || dragData || performance.now() - lastUserTouch < autoplayInterval) {
          return;
        }
        goTo(activeIndex >= n - 1 ? 0 : activeIndex + 1);
      }, autoplayInterval);
    };
    startAutoplay();

    // Toggle Cruise
    cruiseBtn?.addEventListener("click", () => {
      autoplayActive = !autoplayActive;
      if (cruiseBtn) cruiseBtn.classList.toggle("paused", !autoplayActive);
      if (cruiseText) cruiseText.textContent = autoplayActive ? "Cruise: On" : "Cruise: Paused";
    });

    // Step Buttons
    prevBtn?.addEventListener("click", () => {
      lastUserTouch = performance.now();
      goTo(activeIndex - 1);
    });

    nextBtn?.addEventListener("click", () => {
      lastUserTouch = performance.now();
      goTo(activeIndex + 1);
    });

    // Keyboard Navigation
    root.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        lastUserTouch = performance.now();
        goTo(activeIndex + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        lastUserTouch = performance.now();
        goTo(activeIndex - 1);
      }
    });

    // Mouse Wheel / Trackpad Scroll (Direct velocity throw & natural swinging physics)
    root.addEventListener(
      "wheel",
      (e: WheelEvent) => {
        // Prevent outer page scroll hijacking while interacting with gallery
        e.preventDefault();
        lastUserTouch = performance.now();

        const rawDelta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        const delta = e.deltaMode === 1 ? rawDelta * 28 : (e.deltaMode === 2 ? rawDelta * 300 : rawDelta);

        const max = (n - 1) * size.spacing;
        let newOff = sim.off + delta * 0.95;

        // Rubber-band resistance beyond limits
        if (newOff < -size.cw * 0.35) newOff = -size.cw * 0.35;
        if (newOff > max + size.cw * 0.35) newOff = max + size.cw * 0.35;

        sim.off = newOff;
        sim.vel = -delta * 7; // Inject kinetic impulse so cards shake & sway with scroll!

        clearTimeout(wheelTimeout);
        wheelTimeout = setTimeout(() => {
          // Snap to nearest print when wheel scroll ceases
          const targetIndex = nearestAt(sim.off + sim.vel * 0.035, size.spacing, n);
          goTo(targetIndex);
        }, 130);
      },
      { passive: false }
    );

    // Pointer Events (Touch & Drag)
    const onPointerDown = (e: PointerEvent) => {
      // Don't drag if clicking buttons, controls, or links
      if ((e.target as HTMLElement).closest(".pl-bar, .pl-lightbox, button, a")) return;

      lastUserTouch = performance.now();
      dragData = {
        x: e.clientX,
        off: sim.off,
        lx: e.clientX,
        lt: e.timeStamp,
        v: 0,
        moved: false,
      };
    };

    const onPointerMove = (e: PointerEvent) => {
      if (!dragData) return;

      const dx = e.clientX - dragData.x;
      if (!dragData.moved && Math.abs(dx) > 3) {
        dragData.moved = true;
        root.setAttribute("data-drag", "1");
        try {
          root.setPointerCapture(e.pointerId);
        } catch (_) {}
      }

      if (!dragData.moved) return;

      const dt = Math.max(1, e.timeStamp - dragData.lt);
      dragData.v = 0.7 * ((e.clientX - dragData.lx) / dt) + 0.3 * dragData.v;
      dragData.lx = e.clientX;
      dragData.lt = e.timeStamp;

      const max = (n - 1) * size.spacing;
      let off = dragData.off - dx;

      // Rubber-band resistance at limits
      if (off < 0) off *= 0.35;
      if (off > max) off = max + (off - max) * 0.35;

      sim.off = off;
    };

    const onPointerUp = (e: PointerEvent) => {
      if (!dragData) return;

      const wasMoved = dragData.moved;
      const v = dragData.v;
      dragData = null;
      lastUserTouch = performance.now();

      if (wasMoved) {
        root.setAttribute("data-drag", "0");
        sim.vel = -v * 1000;
        const targetIndex = nearestAt(sim.off - v * 180, size.spacing, n);
        goTo(targetIndex);
        return;
      }

      // If clicked without moving, handle card tap
      const cardEl = (e.target as HTMLElement).closest("[data-i]") as HTMLElement | null;
      if (cardEl) {
        const clickedIndex = Number(cardEl.getAttribute("data-i"));
        if (clickedIndex === activeIndex) {
          // Tapping active center card opens full-resolution lightbox!
          openLightbox(clickedIndex);
        } else {
          // Tapping neighboring card slides and swings it into center
          goTo(clickedIndex);
        }
      }
    };

    root.addEventListener("pointerdown", onPointerDown);
    root.addEventListener("pointermove", onPointerMove);
    root.addEventListener("pointerup", onPointerUp);
    root.addEventListener("pointercancel", onPointerUp);

    // Lightbox Dismiss Handlers
    lightboxClose?.addEventListener("click", closeLightbox);
    lightboxBackdrop?.addEventListener("click", closeLightbox);
    lightbox?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape") closeLightbox();
    });

    // Cleanup on page transitions
    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        clearInterval(autoplayTimer);
        clearTimeout(wheelTimeout);
        ro.disconnect();
        io.disconnect();
      },
      { once: true }
    );
  };

  // Run initialization when DOM is loaded and on view transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPolaroidCarousel);
  } else {
    initPolaroidCarousel();
  }
  document.addEventListener("astro:page-load", initPolaroidCarousel);
</script>
