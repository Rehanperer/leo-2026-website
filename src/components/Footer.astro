---
import { siteConfig } from '../data/site';
import Icon from './Icon.astro';
import RippleWaveLoader from './RippleWaveLoader.astro';
---

<footer class="site-footer" role="contentinfo">
  <!-- Top luminous gold & iris dividing sheen -->
  <div class="footer-glow-line" aria-hidden="true"></div>

  <!-- Background atmospheric watermark crest & celestial orbital rings -->
  <div class="footer-bg-elements" aria-hidden="true">
    <div class="footer-watermark-crest">
      <img src="/crest.webp" alt="" class="watermark-img" width="500" height="500" loading="lazy" />
    </div>
    <div class="footer-orbit-ring ring-outer"></div>
    <div class="footer-orbit-ring ring-inner"></div>
    <div class="footer-ambient-aura"></div>
  </div>

  <div class="container footer-container">
    <!-- Top Heroic Crest & Creed Showcase -->
    <div class="footer-hero-banner">
      <div class="footer-hero-brand">
        <div class="footer-crest-stage">
          <img 
            src="/crest.webp" 
            alt="Leo Club of EIC Official Crest" 
            class="footer-hero-crest" 
            width="72" 
            height="72"
            loading="lazy" 
            decoding="async"
          />
          <div class="crest-halo" aria-hidden="true"></div>
        </div>

        <div class="footer-hero-titles">
          <div class="footer-badge-eyebrow">
            <span class="badge-sparkle">✦</span>
            <span>{siteConfig.district}</span>
            <span class="badge-sep">•</span>
            <span>Est. {siteConfig.charterYear}</span>
            <span class="badge-sep">•</span>
            <span>Chartered Under {siteConfig.charteredUnder}</span>
          </div>
          <h3 class="footer-motto-title">
            Leading with <span class="text-gold-serif">Grace,</span> Serving with <span class="text-iris-serif">Integrity.</span>
          </h3>
          <p class="footer-hero-subtitle">
            {siteConfig.fullName} — Colombo 00700, Sri Lanka
          </p>
        </div>
      </div>
    </div>

    <!-- Official Fellowship Channels (Horizontal Luxury Social Bar) -->
    <div class="footer-socials-section">
      <div class="social-pills-row">
        <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer" class="social-pill-btn">
          <span class="social-pill-icon">📸</span>
          <span class="social-pill-name">Instagram</span>
          <Icon name="arrow-right" size={12} class="social-arrow" />
        </a>
        <a href={siteConfig.socials.tiktok} target="_blank" rel="noopener noreferrer" class="social-pill-btn">
          <span class="social-pill-icon">🎵</span>
          <span class="social-pill-name">TikTok</span>
          <Icon name="arrow-right" size={12} class="social-arrow" />
        </a>
        <a href={siteConfig.socials.youtube} target="_blank" rel="noopener noreferrer" class="social-pill-btn">
          <span class="social-pill-icon">▶</span>
          <span class="social-pill-name">YouTube</span>
          <Icon name="arrow-right" size={12} class="social-arrow" />
        </a>
        <a href="/team" class="social-pill-btn">
          <span class="social-pill-icon">✦</span>
          <span class="social-pill-name">Our Team</span>
          <Icon name="arrow-right" size={12} class="social-arrow" />
        </a>
        <a href="/history/leaders" class="social-pill-btn">
          <span class="social-pill-icon">⚜</span>
          <span class="social-pill-name">Former Leaders</span>
          <Icon name="arrow-right" size={12} class="social-arrow" />
        </a>
        <a href="/inspiration" class="social-pill-btn">
          <span class="social-pill-icon">🔥</span>
          <span class="social-pill-name">Inspiration</span>
          <Icon name="arrow-right" size={12} class="social-arrow" />
        </a>
        <a href="/gallery" class="social-pill-btn">
          <span class="social-pill-icon">▦</span>
          <span class="social-pill-name">3D Gallery</span>
          <Icon name="arrow-right" size={12} class="social-arrow" />
        </a>
        <a href="/newsletter" class="social-pill-btn">
          <span class="social-pill-icon">📰</span>
          <span class="social-pill-name">Newsletters</span>
          <Icon name="arrow-right" size={12} class="social-arrow" />
        </a>
        <a href="mailto:contact@eicleos.org" class="social-pill-btn">
          <span class="social-pill-icon">✉</span>
          <span class="social-pill-name">contact@eicleos.org</span>
          <Icon name="arrow-right" size={12} class="social-arrow" />
        </a>
      </div>
    </div>

    <!-- Bottom Legal Bar with Live Activity & Back to Top -->
    <div class="footer-bottom-bar">
      <div class="footer-legal">
        <div class="live-status-pill">
          <!-- Pulse wave loader indicator -->
          <div class="pulse-loader-mini">
            <RippleWaveLoader size="sm" color="gold" />
          </div>
          <span class="status-text">Active Charter • {siteConfig.district} • Est. {siteConfig.charterYear}</span>
        </div>
        <p class="copyright-text">
          © 2026 {siteConfig.fullName}. All rights reserved.
        </p>
      </div>

      <div class="footer-actions-wrap">
        <a href="#hero" class="footer-back-to-top" aria-label="Return to top of page">
          <span>Return to Top</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 15-6-6-6 6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* =========================================================================
     Royal Plum Luxury Nightfall Canvas
     ========================================================================= */
  .site-footer {
    position: relative;
    background: radial-gradient(ellipse 95% 55% at 50% 0%, #2A1A47 0%, #160D26 60%, #0E071A 100%);
    color: #FFFFFF;
    padding-top: clamp(4.5rem, 8vw, 6.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    overflow: hidden;
  }

  /* Radiant golden top dividing line */
  .footer-glow-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg, 
      transparent 0%, 
      rgba(194, 155, 77, 0.4) 25%, 
      rgba(164, 127, 224, 0.9) 50%, 
      rgba(194, 155, 77, 0.4) 75%, 
      transparent 100%
    );
    box-shadow: 0 0 16px rgba(194, 155, 77, 0.5);
  }

  /* Atmospheric background elements */
  .footer-bg-elements {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .footer-watermark-crest {
    position: absolute;
    top: 20%;
    right: -100px;
    opacity: 0.045;
    mix-blend-mode: screen;
    filter: blur(2px);
  }

  .watermark-img {
    width: 620px;
    height: 620px;
    object-fit: contain;
  }

  .footer-orbit-ring {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .ring-outer {
    top: -150px;
    right: -100px;
    width: 600px;
    height: 600px;
    border: 1px dashed rgba(194, 155, 77, 0.12);
    animation: rotateFooterRing 90s linear infinite;
  }

  .ring-inner {
    top: -80px;
    right: -30px;
    width: 460px;
    height: 460px;
    border: 1px solid rgba(122, 87, 184, 0.15);
    animation: rotateFooterRing 60s linear infinite reverse;
  }

  @keyframes rotateFooterRing {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .footer-ambient-aura {
    position: absolute;
    top: 0;
    left: 20%;
    width: 60%;
    height: 250px;
    background: radial-gradient(ellipse at center, rgba(122, 87, 184, 0.18) 0%, transparent 70%);
    filter: blur(60px);
  }

  .footer-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  /* =========================================================================
     Top Heroic Crest & Creed Banner
     ========================================================================= */
  .footer-hero-banner {
    display: flex;
    align-items: center;
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-hero-brand {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .footer-crest-stage {
    position: relative;
    flex-shrink: 0;
  }

  .footer-hero-crest {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 2px solid rgba(194, 155, 77, 0.5);
    box-shadow: 0 0 24px rgba(194, 155, 77, 0.25), 0 8px 16px rgba(0, 0, 0, 0.4);
    background: #FFFFFF;
    transition: transform 0.4s var(--ease-apple);
  }

  .footer-crest-stage:hover .footer-hero-crest {
    transform: scale(1.08) rotate(4deg);
  }

  .crest-halo {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px dashed rgba(194, 155, 77, 0.4);
    animation: rotateFooterRing 30s linear infinite;
  }

  .footer-hero-titles {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-badge-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #F4E8C9;
  }

  .badge-sparkle {
    color: var(--c-gold);
    font-size: 0.8rem;
  }

  .badge-sep {
    opacity: 0.5;
  }

  .footer-motto-title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    font-weight: 600;
    font-style: italic;
    line-height: 1.25;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .text-gold-serif {
    background: linear-gradient(135deg, #F9F0D9 0%, #C29B4D 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-iris-serif {
    background: linear-gradient(135deg, #D4C2F5 0%, #9B79DE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-hero-subtitle {
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.02em;
  }

  /* =========================================================================
     Fellowship & Socials Horizontal Action Strip
     ========================================================================= */
  .footer-socials-section {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 0.5rem 0;
  }

  .social-pills-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
  }

  .social-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1.4rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full, 9999px);
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.86rem;
    backdrop-filter: blur(8px);
    transition: all var(--duration-fast) var(--ease-apple);
  }

  .social-pill-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .social-pill-name {
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .social-arrow {
    opacity: 0.45;
    transition: transform var(--duration-fast) ease, opacity var(--duration-fast) ease;
  }

  .social-pill-btn:hover {
    background: rgba(122, 87, 184, 0.3);
    border-color: rgba(194, 155, 77, 0.5);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(122, 87, 184, 0.3);
  }

  .social-pill-btn:hover .social-arrow {
    opacity: 1;
    color: var(--c-gold);
    transform: translateX(3px);
  }

  /* =========================================================================
     Bottom Legal Bar with Live Indicator & Return to Top
     ========================================================================= */
  .footer-bottom-bar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 720px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.35rem 0.85rem;
    background: rgba(194, 155, 77, 0.12);
    border: 1px solid rgba(194, 155, 77, 0.3);
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .pulse-loader-mini {
    transform: scale(0.65);
    margin: -8px 0;
  }

  .status-text {
    font-size: 0.72rem;
    font-weight: 600;
    color: #F4E8C9;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .copyright-text {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.5;
  }

  .footer-back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(194, 155, 77, 0.3);
    border-radius: var(--radius-full);
    color: #F4E8C9;
    font-size: 0.8rem;
    font-weight: 600;
    transition: all var(--duration-fast) var(--ease-apple);
  }

  .footer-back-to-top:hover {
    background: linear-gradient(135deg, var(--c-iris) 0%, var(--c-iris-deep) 100%);
    border-color: rgba(194, 155, 77, 0.6);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(122, 87, 184, 0.4);
  }
</style>
