---
import { siteConfig } from '../data/site';
---

<section id="hero" class="hero-section" aria-label="Welcome and Hero Section">
  <!-- Subtle decorative ambient watercolor botanical accents -->
  <div class="botanical-accent-top" aria-hidden="true">
    <img 
      src="/botanical/iris-blossom-tl.webp" 
      alt="" 
      class="iris-corner top-left-art" 
      width="400" 
      height="400" 
      loading="eager" 
      decoding="async"
      fetchpriority="low"
    />
  </div>

  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Left Column: Copy & Actions -->
      <div class="hero-content">
        <div class="hero-eyebrow-wrapper">
          <span class="eyebrow eyebrow-gold">
            <span class="sparkle-gold">✦</span>
            <span class="eyebrow-full">{siteConfig.fullName}</span>
            <span class="eyebrow-short">{siteConfig.name}, Colombo 7</span>
          </span>
        </div>

        <h1 class="hero-title">
          Leading with <span class="text-serif-italic text-iris">Grace,</span><br/>
          Serving with <span class="text-serif-italic text-gold">Integrity.</span>
        </h1>

        <p class="hero-lead">
          We are the Leo Club of EIC — a fellowship of dynamic youth leaders cultivating ethical stewardship, compassionate community service, and visionary youth empowerment in Colombo and beyond.
        </p>

        <div class="hero-actions">
          <a href="#about" class="btn btn-primary btn-hero">
            <span>Explore Our Club</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href="#projects" class="btn btn-secondary btn-hero">
            <span>Signature Projects</span>
          </a>
        </div>

        <!-- Trust / Affiliation Bar -->
        <div class="hero-affiliation">
          <div class="affiliation-badge">
            <span class="affil-dot"></span>
            <span>Chartered Under {siteConfig.charteredUnder}</span>
          </div>
          <span class="affil-sep">•</span>
          <span class="affil-year">{siteConfig.district} • Est. {siteConfig.charterYear}</span>
        </div>
      </div>

      <!-- Right Column: Crest Focal Element -->
      <div class="hero-visual">
        <div class="crest-interactive-stage">
          <!-- Concentric orbital luxury rings -->
          <div class="orbit-ring ring-outer" aria-hidden="true"></div>
          <div class="orbit-ring ring-inner" aria-hidden="true"></div>

          <!-- Luminous lavender & gold backdrop radial glow -->
          <div class="crest-glow" aria-hidden="true"></div>

          <!-- The Crest Presentation (Animated Watercolor Crest Video) -->
          <div class="crest-frame-hero">
            <video 
              src="/crest.mp4" 
              poster="/crest.webp" 
              autoplay 
              loop 
              muted 
              playsinline 
              class="crest-video-hero"
              width="460" 
              height="460" 
              aria-label="Leo Club of EIC Official Animated Crest — Leading with Grace, Serving with Integrity"
            >
              <picture>
                <source srcset="/crest.avif" type="image/avif" />
                <source srcset="/crest.webp" type="image/webp" />
                <img 
                  src="/crest.webp" 
                  alt="Leo Club of EIC Official Crest — Leading with Grace, Serving with Integrity" 
                  class="crest-img-hero"
                  width="460" 
                  height="460" 
                  fetchpriority="high"
                  loading="eager" 
                  decoding="async"
                />
              </picture>
            </video>
            <div class="crest-sheen" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative bottom right iris accent -->
  <div class="botanical-accent-bot" aria-hidden="true">
    <img 
      src="/botanical/iris-blossom-br.webp" 
      alt="" 
      class="iris-corner bot-right-art" 
      width="400" 
      height="400" 
      loading="lazy" 
      decoding="async"
    />
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: clamp(6.5rem, 14vh, 9.5rem);
    padding-bottom: clamp(4rem, 8vh, 6.5rem);
    overflow-x: clip;
    overflow-y: visible;
    background: 
      radial-gradient(ellipse 65% 55% at 82% 18%, rgba(254, 238, 204, 0.45) 0%, rgba(245, 218, 162, 0.2) 32%, transparent 68%),
      radial-gradient(ellipse 70% 60% at 75% 45%, rgba(220, 208, 235, 0.38) 0%, rgba(235, 227, 244, 0.2) 50%, transparent 75%),
      radial-gradient(ellipse 65% 55% at 20% 25%, rgba(236, 228, 246, 0.4) 0%, transparent 60%),
      linear-gradient(180deg, #FAF7FD 0%, #F5EEF9 50%, #FAF8FD 100%);
  }

  /* Ambient Watercolor Botanical Corner Highlights */
  .botanical-accent-top {
    position: absolute;
    top: -20px;
    left: -20px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.42;
    mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 20% 20%, #000000 40%, rgba(0, 0, 0, 0.6) 65%, transparent 88%);
    mask-image: radial-gradient(ellipse 85% 85% at 20% 20%, #000000 40%, rgba(0, 0, 0, 0.6) 65%, transparent 88%);
    animation: floatBotanicalTL 14s ease-in-out infinite;
    transition: opacity 0.5s ease;
  }

  .botanical-accent-bot {
    position: absolute;
    bottom: -30px;
    right: -20px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.42;
    mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 75% 75%, #000000 40%, rgba(0, 0, 0, 0.6) 65%, transparent 88%);
    mask-image: radial-gradient(ellipse 85% 85% at 75% 75%, #000000 40%, rgba(0, 0, 0, 0.6) 65%, transparent 88%);
    animation: floatBotanicalBR 16s ease-in-out infinite;
  }

  @keyframes floatBotanicalTL {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(6px, 8px) rotate(1.2deg); }
  }

  @keyframes floatBotanicalBR {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-8px, -6px) rotate(-1.5deg); }
  }

  .iris-corner {
    width: clamp(240px, 32vw, 440px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(122, 87, 184, 0.08));
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Left Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media (max-width: 979px) {
    .hero-content {
      align-items: center;
      text-align: center;
    }
  }

  .hero-eyebrow-wrapper {
    margin-bottom: 0.75rem;
  }

  .sparkle-gold {
    color: var(--c-gold);
    font-size: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--fs-hero);
    font-weight: 600;
    line-height: 1.08;
    color: var(--c-text-primary);
    letter-spacing: -0.015em;
    margin-bottom: 1.35rem;
  }

  .text-serif-italic {
    font-style: italic;
    font-weight: 500;
  }

  .text-iris {
    color: var(--c-iris);
  }

  .text-gold {
    background: linear-gradient(135deg, #B88E3E 0%, #D4AF60 50%, #9F7B2F 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: var(--fs-md);
    color: var(--c-text-secondary);
    line-height: 1.68;
    max-width: 580px;
    margin-bottom: clamp(1.75rem, 4vh, 2.5rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 2.25rem;
  }

  .eyebrow-short {
    display: none;
  }

  @media (max-width: 580px) {
    .eyebrow-full {
      display: none;
    }
    .eyebrow-short {
      display: inline;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-hero {
      width: 100%;
    }
  }

  @media (max-width: 979px) {
    .hero-actions {
      justify-content: center;
    }
  }

  .btn-hero {
    padding: 0.95rem 2rem;
    font-size: 0.92rem;
  }

  /* Affiliation Line */
  .hero-affiliation {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--c-text-tertiary);
    letter-spacing: 0.04em;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border-subtle);
    width: 100%;
    max-width: 480px;
  }

  @media (max-width: 979px) {
    .hero-affiliation {
      justify-content: center;
    }
  }

  .affiliation-badge {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--c-text-secondary);
  }

  .affil-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--c-botanical-green);
    box-shadow: 0 0 6px rgba(72, 142, 98, 0.4);
  }

  .affil-sep {
    color: var(--c-border-subtle);
  }

  /* Right Column: Crest Presentation */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .crest-interactive-stage {
    position: relative;
    width: clamp(260px, 42vw, 440px);
    height: clamp(260px, 42vw, 440px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Rings */
  .orbit-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
  }

  .ring-outer {
    width: 124%;
    height: 124%;
    border: 1px dashed rgba(194, 155, 77, 0.28);
    animation: slowRotate 70s linear infinite;
  }

  .ring-inner {
    width: 112%;
    height: 112%;
    border: 1px solid rgba(122, 87, 184, 0.16);
  }

  /* Glow */
  .crest-glow {
    position: absolute;
    inset: -12%;
    border-radius: 50%;
    background: radial-gradient(circle at 65% 35%, rgba(255, 235, 185, 0.45) 0%, rgba(168, 128, 230, 0.3) 38%, rgba(122, 87, 184, 0.12) 56%, transparent 72%);
    filter: blur(42px);
    pointer-events: none;
  }

  /* Crest Frame */
  .crest-frame-hero {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    padding: 6px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(246, 235, 208, 0.75) 45%, rgba(197, 155, 39, 0.85) 100%);
    box-shadow: 
      0 28px 65px -12px rgba(68, 38, 110, 0.22),
      0 10px 28px -4px rgba(197, 155, 39, 0.2),
      0 0 0 1px rgba(197, 155, 39, 0.3);
    transition: transform var(--duration-normal) var(--ease-apple), box-shadow var(--duration-normal) ease;
  }

  .crest-frame-hero:hover {
    transform: scale(1.025) translateY(-2px);
    box-shadow: 
      0 34px 80px -15px rgba(68, 38, 110, 0.28),
      0 14px 36px -4px rgba(197, 155, 39, 0.28),
      0 0 0 2px rgba(197, 155, 39, 0.45);
  }

  .crest-video-hero,
  .crest-img-hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    transform: scale(1.02);
  }

  .crest-sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, transparent 50%, rgba(255, 255, 255, 0.15) 100%);
    pointer-events: none;
  }

  @keyframes slowRotate {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
</style>
