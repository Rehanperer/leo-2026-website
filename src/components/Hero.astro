---
import { siteConfig } from '../data/site';
---

<section id="hero" class="hero-section" aria-label="Welcome and Hero Section">
  <!-- Subtle decorative ambient watercolor botanical accents -->
  <div class="botanical-accent-top" aria-hidden="true">
    <img 
      src="/botanical/iris-blossom-tl.webp" 
      alt="" 
      class="iris-corner top-left-art" 
      width="400" 
      height="400" 
      loading="eager" 
      decoding="async"
    />
  </div>

  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Left Column: Copy & Actions -->
      <div class="hero-content">
        <div class="hero-eyebrow-wrapper">
          <span class="eyebrow eyebrow-gold">
            <span class="sparkle-gold">✦</span>
            <span class="eyebrow-full">{siteConfig.fullName}</span>
            <span class="eyebrow-short">{siteConfig.name}, Colombo 7</span>
          </span>
        </div>

        <h1 class="hero-title">
          Leading with <span class="text-serif-italic text-iris">Grace,</span><br/>
          Serving with <span class="text-serif-italic text-gold">Integrity.</span>
        </h1>

        <p class="hero-lead">
          We are the Leo Club of EIC — a fellowship of dynamic youth leaders cultivating ethical stewardship, compassionate community service, and visionary youth empowerment in Colombo and beyond.
        </p>

        <div class="hero-actions">
          <a href="#about" class="btn btn-primary btn-hero">
            <span>Explore Our Club</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href="#projects" class="btn btn-secondary btn-hero">
            <span>Signature Projects</span>
          </a>
        </div>

        <!-- Trust / Affiliation Bar -->
        <div class="hero-affiliation">
          <div class="affiliation-badge">
            <span class="affil-dot"></span>
            <span>Chartered Under Lions Clubs International</span>
          </div>
          <span class="affil-sep">•</span>
          <span class="affil-year">Est. {siteConfig.charterYear}</span>
        </div>
      </div>

      <!-- Right Column: Crest Focal Element -->
      <div class="hero-visual">
        <div class="crest-interactive-stage">
          <!-- Concentric orbital luxury rings -->
          <div class="orbit-ring ring-outer" aria-hidden="true"></div>
          <div class="orbit-ring ring-inner" aria-hidden="true"></div>

          <!-- Luminous lavender & gold backdrop radial glow -->
          <div class="crest-glow" aria-hidden="true"></div>

          <!-- The Crest Presentation -->
          <div class="crest-frame-hero">
            <picture>
              <source srcset="/crest.avif" type="image/avif" />
              <source srcset="/crest.webp" type="image/webp" />
              <img 
                src="/crest.png" 
                alt="Leo Club of EIC Official Crest — Leading with Grace, Serving with Integrity" 
                class="crest-img-hero"
                width="460" 
                height="460"
                fetchpriority="high"
                loading="eager"
                decoding="async"
              />
            </picture>
            <div class="crest-sheen" aria-hidden="true"></div>
          </div>

          <!-- Floating Micro-Badge -->
          <div class="floating-stat-pill pill-top">
            <span class="stat-badge-dot"></span>
            <span class="stat-badge-text">District 306 — Sri Lanka</span>
          </div>

          <div class="floating-stat-pill pill-bot">
            <span class="stat-badge-icon">🌿</span>
            <span class="stat-badge-text">Youth Service & Fellowship</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative bottom right iris accent -->
  <div class="botanical-accent-bot" aria-hidden="true">
    <img 
      src="/botanical/iris-blossom-br.webp" 
      alt="" 
      class="iris-corner bot-right-art" 
      width="400" 
      height="400" 
      loading="lazy" 
      decoding="async"
    />
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: clamp(6.5rem, 14vh, 9.5rem);
    padding-bottom: clamp(4rem, 8vh, 6.5rem);
    overflow-x: clip;
    overflow-y: visible;
  }

  /* Ambient Watercolor Botanical Corner Highlights */
  .botanical-accent-top {
    position: absolute;
    top: -20px;
    left: -20px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.42;
    mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 20% 20%, #000000 40%, rgba(0, 0, 0, 0.6) 65%, transparent 88%);
    mask-image: radial-gradient(ellipse 85% 85% at 20% 20%, #000000 40%, rgba(0, 0, 0, 0.6) 65%, transparent 88%);
    animation: floatBotanicalTL 14s ease-in-out infinite;
    transition: opacity 0.5s ease;
  }

  .botanical-accent-bot {
    position: absolute;
    bottom: -30px;
    right: -20px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.42;
    mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 75% 75%, #000000 40%, rgba(0, 0, 0, 0.6) 65%, transparent 88%);
    mask-image: radial-gradient(ellipse 85% 85% at 75% 75%, #000000 40%, rgba(0, 0, 0, 0.6) 65%, transparent 88%);
    animation: floatBotanicalBR 16s ease-in-out infinite;
  }

  @keyframes floatBotanicalTL {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(6px, 8px) rotate(1.2deg); }
  }

  @keyframes floatBotanicalBR {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-8px, -6px) rotate(-1.5deg); }
  }

  .iris-corner {
    width: clamp(240px, 32vw, 440px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(122, 87, 184, 0.08));
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Left Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media (max-width: 979px) {
    .hero-content {
      align-items: center;
      text-align: center;
    }
  }

  .hero-eyebrow-wrapper {
    margin-bottom: 0.75rem;
  }

  .sparkle-gold {
    color: var(--c-gold);
    font-size: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--fs-hero);
    font-weight: 600;
    line-height: 1.08;
    color: var(--c-text-primary);
    letter-spacing: -0.015em;
    margin-bottom: 1.35rem;
  }

  .text-serif-italic {
    font-style: italic;
    font-weight: 500;
  }

  .text-iris {
    color: var(--c-iris);
  }

  .text-gold {
    background: linear-gradient(135deg, #B88E3E 0%, #D4AF60 50%, #9F7B2F 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: var(--fs-md);
    color: var(--c-text-secondary);
    line-height: 1.68;
    max-width: 580px;
    margin-bottom: clamp(1.75rem, 4vh, 2.5rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 2.25rem;
  }

  .eyebrow-short {
    display: none;
  }

  @media (max-width: 580px) {
    .eyebrow-full {
      display: none;
    }
    .eyebrow-short {
      display: inline;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-hero {
      width: 100%;
    }
  }

  @media (max-width: 979px) {
    .hero-actions {
      justify-content: center;
    }
  }

  .btn-hero {
    padding: 0.95rem 2rem;
    font-size: 0.92rem;
  }

  /* Affiliation Line */
  .hero-affiliation {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--c-text-tertiary);
    letter-spacing: 0.04em;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border-subtle);
    width: 100%;
    max-width: 480px;
  }

  @media (max-width: 979px) {
    .hero-affiliation {
      justify-content: center;
    }
  }

  .affiliation-badge {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--c-text-secondary);
  }

  .affil-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--c-botanical-green);
    box-shadow: 0 0 6px rgba(72, 142, 98, 0.4);
  }

  .affil-sep {
    color: var(--c-border-subtle);
  }

  /* Right Column: Crest Presentation */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .crest-interactive-stage {
    position: relative;
    width: clamp(260px, 42vw, 440px);
    height: clamp(260px, 42vw, 440px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Rings */
  .orbit-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
  }

  .ring-outer {
    width: 124%;
    height: 124%;
    border: 1px dashed rgba(194, 155, 77, 0.28);
    animation: slowRotate 70s linear infinite;
  }

  .ring-inner {
    width: 112%;
    height: 112%;
    border: 1px solid rgba(122, 87, 184, 0.16);
  }

  /* Glow */
  .crest-glow {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(155, 121, 222, 0.3) 0%, rgba(244, 232, 201, 0.25) 45%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  /* Crest Frame */
  .crest-frame-hero {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    padding: 6px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(244, 232, 201, 0.6) 50%, rgba(194, 155, 77, 0.8) 100%);
    box-shadow: 
      0 24px 60px -12px rgba(50, 28, 88, 0.18),
      0 8px 24px -4px rgba(194, 155, 77, 0.15),
      0 0 0 1px rgba(194, 155, 77, 0.25);
    transition: transform var(--duration-normal) var(--ease-apple), box-shadow var(--duration-normal) ease;
  }

  .crest-frame-hero:hover {
    transform: scale(1.025) translateY(-2px);
    box-shadow: 
      0 32px 75px -15px rgba(50, 28, 88, 0.24),
      0 12px 32px -4px rgba(194, 155, 77, 0.25),
      0 0 0 2px rgba(194, 155, 77, 0.4);
  }

  .crest-img-hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  .crest-sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, transparent 50%, rgba(255, 255, 255, 0.15) 100%);
    pointer-events: none;
  }

  /* Floating Stat Pills */
  .floating-stat-pill {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(122, 87, 184, 0.18);
    box-shadow: var(--shadow-md);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--c-text-primary);
    white-space: nowrap;
    z-index: 5;
    pointer-events: none;
    transition: transform 0.3s ease;
  }

  .pill-top {
    top: 5%;
    right: -10px;
    animation: pillFloat 6s ease-in-out infinite alternate;
  }

  .pill-bot {
    bottom: 5%;
    left: -10px;
    animation: pillFloat 7s ease-in-out infinite alternate-reverse;
  }

  @media (max-width: 640px) {
    .floating-stat-pill {
      display: none;
    }
  }

  .stat-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--c-gold);
    box-shadow: 0 0 8px rgba(194, 155, 77, 0.6);
  }

  .stat-badge-icon {
    font-size: 0.85rem;
  }

  @keyframes slowRotate {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @keyframes pillFloat {
    0% { transform: translateY(0); }
    100% { transform: translateY(-8px); }
  }
</style>
