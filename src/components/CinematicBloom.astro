---
// CinematicBloom.astro — Super Cinematic Botanical Bloom Intro
---

<div id="cinematic-intro" class="cinematic-overlay" role="dialog" aria-modal="true" aria-label="Cinematic Flower Bloom Experience">
  <!-- Atmospheric clean background -->
  <div class="cinematic-backdrop"></div>

  <!-- Ambient floating stardust / pollen particles -->
  <div class="particle-field" aria-hidden="true">
    <span class="particle p-1"></span>
    <span class="particle p-2"></span>
    <span class="particle p-3"></span>
    <span class="particle p-4"></span>
    <span class="particle p-5"></span>
    <span class="particle p-6"></span>
    <span class="particle p-7"></span>
    <span class="particle p-8"></span>
    <span class="particle p-9"></span>
    <span class="particle p-10"></span>
  </div>

  <!-- Stage: Central Bloom Stage -->
  <div class="bloom-stage">
    <!-- Golden energy rings expanding with bloom -->
    <div class="bloom-aura ring-1"></div>
    <div class="bloom-aura ring-2"></div>
    <div class="bloom-aura ring-3"></div>

    <!-- Motto Eyebrow above bloom -->
    <div class="motto-reveal">
      <span class="motto-pill">
        <span class="motto-sparkle">✦</span>
        LEO CLUB OF EIC
        <span class="motto-sparkle">✦</span>
      </span>
      <h2 class="motto-text">Leading with Grace, Serving with Integrity</h2>
    </div>

    <!-- The blooming flower container -->
    <div class="flower-bloom-core">
      <!-- Centerpiece: Blooming Watercolor Iris & Globe Seamless Video -->
      <div class="bloom-artwork-wrapper">
        <video 
          id="bloom-video"
          class="blooming-iris-video"
          autoplay 
          muted 
          playsinline 
          preload="auto"
          poster="/blooming-iris-globe.webp"
        >
          <source src="/bloom-video.mp4" type="video/mp4" />
          <source src="/Globe_spinning_and_flower_blooming_20261011111216.mp4" type="video/mp4" />
          <img 
            src="/blooming-iris-globe.webp" 
            alt="Blooming Iris on Earth Globe" 
            class="blooming-iris-art" 
            width="360" 
            height="360" 
          />
        </video>

      </div>
    </div>

    <!-- Subtitle caption -->
    <div class="bloom-caption">
      <p class="caption-district">Colombo 7, Sri Lanka</p>
    </div>
  </div>

  <!-- Skip / Enter Experience Button -->
  <div class="cinematic-controls">
    <button id="skip-intro-btn" class="skip-btn" aria-label="Skip intro to main site">
      <span>Skip Intro</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="5 4 15 12 5 20 5 4"/>
        <line x1="19" y1="5" x2="19" y2="19"/>
      </svg>
    </button>
  </div>
</div>

<style>
  /* =========================================================================
     Cinematic Overlay: Fullscreen Apple-Grade Presentation
     ========================================================================= */
  .cinematic-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #FAF8FD;
    overflow: hidden;
    user-select: none;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.5s ease;
  }

  .cinematic-overlay.dismissed {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Backdrop atmospheric mists */
  .cinematic-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .mist-layer {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
    animation: mistFloat 12s ease-in-out infinite alternate;
  }

  .mist-1 {
    width: 70vw;
    height: 70vw;
    max-width: 800px;
    max-height: 800px;
    top: -15%;
    left: -10%;
    background: radial-gradient(circle, rgba(206, 185, 238, 0.55) 0%, rgba(250, 248, 253, 0) 70%);
  }

  .mist-2 {
    width: 60vw;
    height: 60vw;
    max-width: 700px;
    max-height: 700px;
    bottom: -10%;
    right: -10%;
    background: radial-gradient(circle, rgba(244, 230, 195, 0.5) 0%, rgba(250, 248, 253, 0) 70%);
    animation-delay: -6s;
  }

  .sunbeam {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 100vh;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.9) 0%, rgba(250, 248, 253, 0.4) 45%, transparent 75%);
    pointer-events: none;
  }

  /* Particles / Golden Stardust */
  .particle-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, #F4E8C9 0%, #C29B4D 100%);
    box-shadow: 0 0 8px rgba(194, 155, 77, 0.6);
    opacity: 0;
    animation: particleDrift 4s ease-out infinite;
  }

  .p-1  { width: 4px; height: 4px; top: 40%; left: 35%; animation-delay: 0.3s; }
  .p-2  { width: 6px; height: 6px; top: 60%; left: 65%; animation-delay: 0.8s; }
  .p-3  { width: 3px; height: 3px; top: 30%; left: 60%; animation-delay: 1.2s; }
  .p-4  { width: 5px; height: 5px; top: 70%; left: 30%; animation-delay: 1.5s; }
  .p-5  { width: 4px; height: 4px; top: 25%; left: 45%; animation-delay: 0.6s; }
  .p-6  { width: 7px; height: 7px; top: 55%; left: 25%; animation-delay: 1.9s; }
  .p-7  { width: 3px; height: 3px; top: 75%; left: 55%; animation-delay: 2.1s; }
  .p-8  { width: 5px; height: 5px; top: 35%; left: 75%; animation-delay: 0.4s; }
  .p-9  { width: 4px; height: 4px; top: 80%; left: 45%; animation-delay: 2.4s; }
  .p-10 { width: 6px; height: 6px; top: 20%; left: 50%; animation-delay: 1.7s; }

  /* Central Bloom Stage */
  .bloom-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    max-width: 540px;
    padding-inline: 1.5rem;
    z-index: 2;
  }

  /* Golden energy shockwave rings */
  .bloom-aura {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    border: 1px solid rgba(194, 155, 77, 0.4);
    transform: translate(-50%, -50%) scale(0.2);
    opacity: 0;
    pointer-events: none;
  }

  .ring-1 {
    width: 320px;
    height: 320px;
    animation: auraShockwave 2.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
  }

  .ring-2 {
    width: 440px;
    height: 440px;
    border-color: rgba(122, 87, 184, 0.3);
    animation: auraShockwave 3.1s cubic-bezier(0.16, 1, 0.3, 1) 0.9s forwards;
  }

  .ring-3 {
    width: 580px;
    height: 580px;
    border-style: dashed;
    border-color: rgba(194, 155, 77, 0.2);
    animation: auraShockwave 3.4s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
  }

  /* Motto typography reveal */
  .motto-reveal {
    margin-bottom: clamp(1rem, 3vh, 1.75rem);
    opacity: 0;
    transform: translateY(14px);
    animation: textGraceFade 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  .motto-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9F7B2F;
    background: rgba(194, 155, 77, 0.12);
    border: 1px solid rgba(194, 155, 77, 0.35);
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 0.65rem;
  }

  .motto-sparkle {
    color: #C29B4D;
    font-size: 0.65rem;
  }

  .motto-text {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    font-weight: 600;
    font-style: italic;
    color: #211638;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  /* Flower Bloom Core Stage */
  .flower-bloom-core {
    position: relative;
    width: clamp(300px, 88vw, 680px);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-block: 0.5rem;
  }

  /* Botanical Leaves Unfurl */
  .bloom-stem-leaves {
    position: absolute;
    inset: -10%;
    pointer-events: none;
    z-index: 1;
  }

  .svg-leaf {
    position: absolute;
    width: 45%;
    height: 45%;
    opacity: 0;
  }

  .left-leaf {
    bottom: 8%;
    left: 8%;
    transform-origin: bottom right;
    animation: leafBloomLeft 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
  }

  .right-leaf {
    bottom: 8%;
    right: 8%;
    transform-origin: bottom left;
    animation: leafBloomRight 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.65s forwards;
  }

  /* Central Blooming Iris & Globe Artwork — Seamless Natural Blend */
  .bloom-artwork-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    background: transparent;
    -webkit-mask-image: radial-gradient(ellipse 65% 62% at 50% 50%, #000000 30%, rgba(0, 0, 0, 0.6) 55%, transparent 76%);
    mask-image: radial-gradient(ellipse 65% 62% at 50% 50%, #000000 30%, rgba(0, 0, 0, 0.6) 55%, transparent 76%);
    animation: irisBloomUnfurl 2.2s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  .blooming-iris-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    mix-blend-mode: multiply;
  }

  .blooming-iris-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .petal-glow {
    position: absolute;
    inset: -15%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(155, 121, 222, 0.45) 0%, rgba(244, 232, 201, 0.25) 45%, transparent 70%);
    pointer-events: none;
    animation: pulseGlow 3s ease-in-out infinite alternate;
  }

  /* Seal removed for video focus */

  /* Caption below flower */
  .bloom-caption {
    margin-top: clamp(0.75rem, 2vh, 1.25rem);
    opacity: 0;
    transform: translateY(8px);
    animation: textGraceFade 1s cubic-bezier(0.16, 1, 0.3, 1) 1.8s forwards;
  }

  .caption-district {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: #5C5272;
  }

  /* Skip Button */
  .cinematic-controls {
    position: absolute;
    bottom: clamp(1.25rem, 3.5vh, 2.5rem);
    right: clamp(1.25rem, 4vw, 2.5rem);
    z-index: 10;
  }

  .skip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #5C5272;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(122, 87, 184, 0.18);
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(33, 22, 56, 0.05);
    transition: all 0.25s ease;
  }

  .skip-btn:hover {
    background: #FFFFFF;
    color: #211638;
    border-color: #7A57B8;
    box-shadow: 0 6px 18px rgba(122, 87, 184, 0.18);
    transform: translateY(-1px);
  }

  /* =========================================================================
     Keyframe Choreography: Pure 60/120 FPS GPU Transformations
     ========================================================================= */
  @keyframes irisBloomUnfurl {
    0% {
      opacity: 0;
      transform: scale(0.18) rotate(-18deg) translateY(40px);
      filter: blur(8px) brightness(1.2);
    }
    45% {
      opacity: 1;
      transform: scale(1.08) rotate(3deg) translateY(-6px);
      filter: blur(0px) brightness(1.05);
    }
    70% {
      transform: scale(0.97) rotate(-1deg) translateY(2px);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg) translateY(0);
      filter: blur(0px) brightness(1);
    }
  }

  @keyframes leafBloomLeft {
    0% {
      opacity: 0;
      transform: scale(0.2) rotate(-40deg);
    }
    100% {
      opacity: 0.85;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes leafBloomRight {
    0% {
      opacity: 0;
      transform: scale(0.2) rotate(40deg);
    }
    100% {
      opacity: 0.85;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes auraShockwave {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.25);
    }
    40% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.18);
    }
  }

  @keyframes sealLockIn {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.85);
    }
    60% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.03);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes glintSweep {
    0% {
      opacity: 0;
      transform: translateX(-100%) rotate(45deg);
    }
    50% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translateX(100%) rotate(45deg);
    }
  }

  @keyframes textGraceFade {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes particleDrift {
    0% {
      opacity: 0;
      transform: translateY(0) scale(0.6);
    }
    40% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: translateY(-50px) scale(1.1);
    }
  }

  @keyframes pulseGlow {
    0% { opacity: 0.35; transform: scale(0.95); }
    100% { opacity: 0.75; transform: scale(1.05); }
  }

  @keyframes mistFloat {
    0% { transform: translateY(0) scale(1); }
    100% { transform: translateY(-20px) scale(1.05); }
  }

  /* Accessibility: Prefers reduced motion skips straight through */
  @media (prefers-reduced-motion: reduce) {
    .cinematic-overlay {
      display: none !important;
    }
  }
</style>

<script>
  let dismissTimer: ReturnType<typeof setTimeout> | null = null;
  let isIntroActive = false;

  function dismissIntro() {
    if (!isIntroActive) return;
    isIntroActive = false;

    if (dismissTimer) {
      clearTimeout(dismissTimer);
      dismissTimer = null;
    }

    const overlay = document.getElementById('cinematic-intro');
    if (overlay) {
      overlay.classList.add('dismissed');
      overlay.classList.remove('is-active');
      setTimeout(() => {
        if (overlay && overlay.classList.contains('dismissed')) {
          overlay.style.display = 'none';
        }
      }, 520);
    }

    try {
      sessionStorage.setItem('leo_eic_intro_seen', 'true');
    } catch (e) {}

    document.body.classList.remove('intro-active');
    window.dispatchEvent(new CustomEvent('cinematic-intro-complete'));
  }

  function startIntroSequence() {
    const overlay = document.getElementById('cinematic-intro');
    if (!overlay) return;

    if (dismissTimer) {
      clearTimeout(dismissTimer);
      dismissTimer = null;
    }

    isIntroActive = true;
    try {
      sessionStorage.removeItem('leo_eic_intro_seen');
    } catch (e) {}

    document.body.classList.add('intro-active');

    // Ensure overlay is visible and active
    overlay.style.display = 'flex';
    overlay.classList.remove('dismissed');
    overlay.classList.remove('is-active');
    void overlay.offsetWidth; // Force DOM reflow so CSS animations reset cleanly
    overlay.classList.add('is-active');

    // Restart and play video
    const vid = document.getElementById('bloom-video') as HTMLVideoElement | null;
    if (vid) {
      try {
        vid.currentTime = 0;
        vid.muted = true;
        const playPromise = vid.play();
        if (playPromise !== undefined) {
          playPromise.catch((err) => {
            console.warn('Cinematic video autoplay notice:', err);
          });
        }
      } catch (err) {
        console.warn('Video reset error:', err);
      }

      vid.onended = () => {
        dismissIntro();
      };
    }

    // Auto-dismiss sequence gracefully after 4.8 seconds
    dismissTimer = setTimeout(dismissIntro, 4800);
  }

  // Define and expose replay handler globally immediately on script execution
  function replayCinematicIntro() {
    // Scroll window smoothly to top so hero reveals properly
    window.scrollTo({ top: 0, behavior: 'instant' });
    startIntroSequence();
  }

  // Register globally & listen for custom events immediately upon script evaluation
  (window as any).replayCinematicIntro = replayCinematicIntro;
  window.addEventListener('replay-cinematic-intro', replayCinematicIntro);

  function initCinematicIntro() {
    const overlay = document.getElementById('cinematic-intro');
    const skipBtn = document.getElementById('skip-intro-btn');
    if (!overlay) return;

    // Attach skip button handler
    skipBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dismissIntro();
    });

    // Escape key listener (active whenever intro is showing)
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isIntroActive) {
        dismissIntro();
      }
    });

    // Check if user already saw intro in current browser session or passed ?intro=0
    let hasSeen = false;
    try {
      hasSeen = sessionStorage.getItem('leo_eic_intro_seen') === 'true';
    } catch (e) {}

    const urlParams = new URLSearchParams(window.location.search);
    if (hasSeen || urlParams.get('intro') === '0') {
      overlay.classList.add('dismissed');
      overlay.style.display = 'none';
      isIntroActive = false;
      document.body.classList.remove('intro-active');
      return;
    }

    // First time in session: run sequence automatically
    startIntroSequence();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCinematicIntro);
  } else {
    initCinematicIntro();
  }
</script>
