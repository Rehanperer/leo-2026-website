---
interface JourneyItem {
  id: string;
  year: string;
  month: string;
  tag?: string;
  content: string;
}

interface Props {
  title?: string;
  periodLabel?: string;
  activeColor?: string;
  imageUrl?: string;
  imageAlt?: string;
}

const {
  title = "Our Living Storyline",
  periodLabel = "2022 — 2027 Charter Arc",
  imageUrl = "/history/history-22-23.png",
  imageAlt = "Charter Era — Leo Club of Ethos International"
} = Astro.props;

// Master Chronological Milestones
const chronologicalJourney: JourneyItem[] = [
  {
    id: "2022-march",
    year: "2022",
    month: "March",
    tag: "Founding Era",
    content: "Charter Dawn: Officially founded under Lions Club of Colombo West (District 306 D2) led by our inaugural Charter President."
  },
  {
    id: "2022-november",
    year: "2022",
    month: "November",
    tag: "Civic Health",
    content: "Inaugural community medical camps, club constitution bylaws, and ceremonial crest adoption."
  },
  {
    id: "2023-april",
    year: "2023",
    month: "April",
    tag: "Youth Network",
    content: "Serve. Inspire. Grow: Rapid membership expansion into schools, colleges, and university campuses."
  },
  {
    id: "2023-october",
    year: "2023",
    month: "October",
    tag: "Eco Sanctuary",
    content: "Tree canopy conservation drives and recurring compassionate eldercare home sanctuaries."
  },
  {
    id: "2024-july",
    year: "2024",
    month: "July",
    tag: "Flagship Service",
    content: "Expanding Horizons: Flagship 'Service with Spice' project and large-scale youth welfare initiatives."
  },
  {
    id: "2025-march",
    year: "2025",
    month: "March",
    tag: "District Summit",
    content: "Hosted District 306 D2 Youth Orientation Summit and forged international Leo fellowships."
  },
  {
    id: "2026-may",
    year: "2026",
    month: "May",
    tag: "The Future",
    content: "The Future Awaits: 2026/2027 cabinet installations, digital platforms, and lasting social impact."
  }
];

// Desktop Alternating Tracks
const topJourneyData: JourneyItem[] = [
  chronologicalJourney[0],
  chronologicalJourney[2],
  chronologicalJourney[4],
  chronologicalJourney[6]
];

const bottomJourneyData: JourneyItem[] = [
  chronologicalJourney[1],
  chronologicalJourney[3],
  chronologicalJourney[5]
];
---

<section id="journey" class="timeline-section" aria-label="Club Historical Journey">
  <!-- DESKTOP PINNED SCRUB VIEWPORT (Visible on screens > 768px) -->
  <div class="timeline-sticky-viewport" aria-hidden="false">
      <!-- Ambient Golden Aura -->
      <div class="timeline-aura" aria-hidden="true"></div>

      <div class="whole-slider-track" id="whole-slider-track">
        <!-- Left Featured Milestone Picture -->
        <div class="timeline-featured-card">
          <div class="featured-media-frame">
            <img src={imageUrl} alt={imageAlt} class="featured-img" loading="lazy" decoding="async" />
            <div class="featured-sheen" aria-hidden="true"></div>
            <div class="featured-badge">
              <span class="badge-sparkle">✦</span>
              <span>Est. 2022 • Colombo 7</span>
            </div>
          </div>
        </div>

        <!-- Main Horizontal Timeline Canvas -->
        <div class="timeline-content-stage">
          <!-- Central Horizontal Connecting Line -->
          <div class="timeline-axis-line-container" aria-hidden="true">
            <div class="axis-node-dot start-dot"></div>
            <div class="journey-line"></div>
            <div class="axis-node-dot end-dot"></div>
          </div>

          <!-- Upper Half: Top Milestones -->
          <div class="timeline-half top-half">
            <div class="title-column">
              <span class="eyebrow eyebrow-gold">Historical Tapestry</span>
              <h2 class="timeline-main-title">
                {title}
              </h2>
            </div>

            <div class="milestones-row top-milestones-row">
              {topJourneyData.map((item) => (
                <div class="milestone-item top-item" data-id={item.id}>
                  <!-- Vertical Stem and Dot -->
                  <div class="stem-container top-stem">
                    <div class={`stem-dot jd-${item.id}`}></div>
                    <div class={`stem-line jl-${item.id}`}></div>
                  </div>

                  <!-- Text Block -->
                  <div class="milestone-text-block">
                    <h4 class={`milestone-date title-${item.id}`}>
                      <span class="date-year">{item.year}</span>
                      <span class="date-month">{item.month}</span>
                    </h4>
                    <p class={`milestone-content description-${item.id}`}>
                      {item.content}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Lower Half: Bottom Milestones -->
          <div class="timeline-half bottom-half">
            <div class="period-column">
              <span class="period-pill">{periodLabel}</span>
              <p class="period-sub">Scroll to travel through our history</p>
            </div>

            <div class="milestones-row bottom-milestones-row">
              {bottomJourneyData.map((item) => (
                <div class="milestone-item bottom-item" data-id={item.id}>
                  <!-- Vertical Stem and Dot -->
                  <div class="stem-container bottom-stem">
                    <div class={`stem-line jl-${item.id}`}></div>
                    <div class={`stem-dot jd-${item.id}`}></div>
                  </div>

                  <!-- Text Block -->
                  <div class="milestone-text-block bottom-text-block">
                    <h4 class={`milestone-date title-${item.id}`}>
                      <span class="date-year">{item.year}</span>
                      <span class="date-month">{item.month}</span>
                    </h4>
                    <p class={`milestone-content description-${item.id}`}>
                      {item.content}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

  <!-- MOBILE CHRONOLOGICAL EXPERIENCE (Visible on screens <= 768px) -->
  <div class="timeline-mobile-stage" aria-label="Mobile Historical Journey">
    <div class="mobile-stage-inner">
      <!-- Mobile Masthead -->
      <header class="mobile-timeline-header">
        <span class="eyebrow eyebrow-gold">Historical Tapestry</span>
        <h2 class="mobile-timeline-title">{title}</h2>
        <div class="mobile-period-wrap">
          <span class="period-pill">{periodLabel}</span>
        </div>
      </header>

      <!-- Featured Visual Card for Mobile -->
      <div class="mobile-featured-card">
        <div class="featured-media-frame">
          <img src={imageUrl} alt={imageAlt} class="featured-img" loading="lazy" decoding="async" />
          <div class="featured-sheen" aria-hidden="true"></div>
          <div class="featured-badge">
            <span class="badge-sparkle">✦</span>
            <span>Est. 2022 • Colombo 7</span>
          </div>
        </div>
      </div>

      <!-- Chronological Vertical Stream -->
      <div class="mobile-timeline-stream">
        <div class="mobile-spine-track" aria-hidden="true">
          <div class="mobile-spine-line"></div>
        </div>

        <div class="mobile-milestones-list">
          {chronologicalJourney.map((item, index) => (
            <article class="mobile-milestone-entry" data-index={index}>
              <!-- Spine Node Point -->
              <div class="mobile-node-container" aria-hidden="true">
                <div class="mobile-node-ring"></div>
                <div class="mobile-node-core"></div>
              </div>

              <!-- Milestone Glass Card -->
              <div class="mobile-card card-glass">
                <header class="mobile-card-top">
                  <div class="mobile-date-cluster">
                    <span class="mobile-year">{item.year}</span>
                    <span class="mobile-month">{item.month}</span>
                  </div>
                  {item.tag && (
                    <span class="mobile-tag-badge">{item.tag}</span>
                  )}
                </header>
                <p class="mobile-card-desc">
                  {item.content}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Outer Section */
  .timeline-section {
    position: relative;
    width: 100%;
    background: var(--c-bg, #FAF8FD);
    color: var(--c-text-primary, #211638);
  }

  /* Desktop vs Mobile Responsive Display Switch */
  @media (min-width: 769px) {
    .timeline-section {
      height: 220vw;
    }
    .timeline-sticky-viewport {
      display: flex;
    }
    .timeline-mobile-stage {
      display: none !important;
    }
  }

  @media (max-width: 768px) {
    .timeline-section {
      height: auto;
      padding: clamp(3rem, 6vw, 4.5rem) 0 clamp(4rem, 8vw, 5.5rem);
    }
    .timeline-sticky-viewport {
      display: none !important;
    }
    .timeline-mobile-stage {
      display: block;
    }
  }

  /* ====================================================
     DESKTOP PINNED SCRUB STYLES
     ==================================================== */
  .timeline-sticky-viewport {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    align-items: center;
    overflow: hidden;
    padding-top: clamp(1.5rem, 3vh, 2.5rem);
  }

  .timeline-aura {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 1200px;
    height: 600px;
    background: radial-gradient(ellipse 60% 40% at 50% 50%, rgba(122, 87, 184, 0.08) 0%, rgba(194, 155, 77, 0.06) 45%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  /* Horizontal Slider */
  .whole-slider-track {
    position: relative;
    display: flex;
    align-items: center;
    height: 36vw;
    min-height: 480px;
    width: max-content;
    gap: clamp(2.5rem, 3.5vw, 4rem);
    padding: 0 clamp(2.5rem, 4vw, 5rem);
    will-change: transform;
    z-index: 1;
  }

  /* Featured Left Image Card */
  .timeline-featured-card {
    width: clamp(280px, 24vw, 360px);
    height: 100%;
    flex-shrink: 0;
  }

  .featured-media-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(194, 155, 77, 0.35);
    box-shadow: 0 20px 50px rgba(33, 22, 56, 0.12), 0 0 30px rgba(122, 87, 184, 0.1);
    background: #0E071A;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(14, 7, 26, 0.75) 100%);
    pointer-events: none;
  }

  .featured-badge {
    position: absolute;
    bottom: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(14, 7, 26, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(194, 155, 77, 0.4);
    border-radius: 9999px;
    color: #FAF8FD;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .badge-sparkle { color: #C29B4D; }

  /* Content Stage */
  .timeline-content-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Central Axis Line */
  .timeline-axis-line-container {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    display: flex;
    align-items: center;
    z-index: 2;
    pointer-events: none;
  }

  .axis-node-dot {
    width: 0.75vw;
    height: 0.75vw;
    min-width: 8px;
    min-height: 8px;
    border-radius: 50%;
    background: #C29B4D;
    box-shadow: 0 0 12px #C29B4D;
    flex-shrink: 0;
  }

  .journey-line {
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #C29B4D 0%, #7A57B8 50%, #C29B4D 100%);
    border-radius: 9999px;
    will-change: width;
  }

  /* Half Rows */
  .timeline-half {
    position: relative;
    width: 100%;
    height: 50%;
    display: flex;
    align-items: center;
  }

  .top-half {
    align-items: flex-end;
    padding-bottom: 1.5vw;
  }

  .bottom-half {
    align-items: flex-start;
    padding-top: 1.5vw;
  }

  /* Header Columns */
  .title-column {
    width: clamp(200px, 18vw, 280px);
    flex-shrink: 0;
    padding-right: 1.5vw;
  }

  .timeline-main-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.8rem, 2.6vw, 3rem);
    line-height: 1.1;
    color: var(--c-text-primary, #211638);
    margin: 4px 0 0;
  }

  .period-column {
    width: clamp(200px, 18vw, 280px);
    flex-shrink: 0;
    padding-right: 1.5vw;
  }

  .period-pill {
    display: inline-block;
    padding: 4px 12px;
    background: var(--c-iris-soft, #EDE6F9);
    border: 1px solid rgba(122, 87, 184, 0.25);
    border-radius: 9999px;
    color: var(--c-iris-deep, #54398A);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .period-sub {
    font-size: 0.75rem;
    color: var(--c-text-tertiary, #8C82A2);
    margin: 6px 0 0;
  }

  /* Milestone Rows */
  .milestones-row {
    display: flex;
    gap: clamp(6vw, 10vw, 14vw);
  }

  .top-milestones-row {
    padding-left: 1vw;
  }

  .bottom-milestones-row {
    padding-left: 6vw;
  }

  .milestone-item {
    position: relative;
    width: clamp(260px, 22vw, 340px);
    flex-shrink: 0;
  }

  /* Stems and Dots */
  .stem-container {
    position: absolute;
    left: 0;
    width: 2px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .top-stem {
    bottom: -1.5vw;
    height: 10vw;
    justify-content: flex-end;
  }

  .bottom-stem {
    top: -1.5vw;
    height: 10vw;
    justify-content: flex-start;
  }

  .stem-dot {
    width: 0.85vw;
    height: 0.85vw;
    min-width: 10px;
    min-height: 10px;
    border-radius: 50%;
    background: #C29B4D;
    box-shadow: 0 0 10px #C29B4D;
    transform: translateX(-50%) scale(0);
    will-change: transform;
    flex-shrink: 0;
  }

  .stem-line {
    width: 2px;
    height: 100%;
    background: #C29B4D;
    transform: scaleY(0);
    will-change: transform;
  }

  .top-stem .stem-line { transform-origin: bottom bottom; }
  .bottom-stem .stem-line { transform-origin: top top; }

  /* Milestone Text Blocks */
  .milestone-text-block {
    padding-left: 2vw;
    padding-bottom: 2vw;
    will-change: transform, opacity;
  }

  .bottom-text-block {
    padding-top: 2vw;
    padding-bottom: 0;
  }

  .milestone-date {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0 0 6px;
    line-height: 1;
  }

  .date-year {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.4rem, 2vw, 2.2rem);
    font-weight: 700;
    color: var(--c-iris-deep, #54398A);
  }

  .date-month {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #9F7B2F;
  }

  .milestone-content {
    font-size: clamp(0.8125rem, 1vw, 0.95rem);
    color: var(--c-text-secondary, #5C5272);
    line-height: 1.5;
    margin: 0;
  }

  /* ====================================================
     MOBILE DEDICATED STREAM STYLES (<= 768px)
     ==================================================== */
  .timeline-mobile-stage {
    position: relative;
    width: 100%;
    padding-inline: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
    z-index: 2;
  }

  .mobile-timeline-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .mobile-timeline-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.9rem, 6.5vw, 2.6rem);
    line-height: 1.15;
    color: var(--c-text-primary, #211638);
    margin: 6px 0 12px;
  }

  .mobile-period-wrap {
    display: flex;
    justify-content: center;
  }

  .mobile-featured-card {
    width: 100%;
    height: 220px;
    border-radius: 20px;
    margin-bottom: 2.25rem;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(33, 22, 56, 0.1);
  }

  .mobile-timeline-stream {
    position: relative;
    padding-left: 28px;
  }

  .mobile-spine-track {
    position: absolute;
    left: 8px;
    top: 14px;
    bottom: 14px;
    width: 2px;
  }

  .mobile-spine-line {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #C29B4D 0%, #7A57B8 50%, #C29B4D 100%);
    border-radius: 9999px;
    opacity: 0.65;
  }

  .mobile-milestones-list {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .mobile-milestone-entry {
    position: relative;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-milestone-entry.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-node-container {
    position: absolute;
    left: -28px;
    top: 22px;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateX(-50%);
  }

  .mobile-node-core {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #C29B4D;
    box-shadow: 0 0 10px #C29B4D;
    z-index: 2;
  }

  .mobile-node-ring {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid rgba(194, 155, 77, 0.4);
    background: rgba(255, 255, 255, 0.85);
    z-index: 1;
  }

  .mobile-card {
    padding: 1.15rem 1.25rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(194, 155, 77, 0.28);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 10px 24px -6px rgba(33, 22, 56, 0.06);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .mobile-card:hover {
    border-color: rgba(194, 155, 77, 0.55);
    box-shadow: 0 14px 30px -6px rgba(122, 87, 184, 0.12);
  }

  .mobile-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.55rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .mobile-date-cluster {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .mobile-year {
    font-family: var(--font-serif, serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--c-iris-deep, #54398A);
    line-height: 1;
  }

  .mobile-month {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9F7B2F;
  }

  .mobile-tag-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    background: rgba(194, 155, 77, 0.12);
    border: 1px solid rgba(194, 155, 77, 0.3);
    color: #9F7B2F;
    border-radius: 9999px;
  }

  .mobile-card-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--c-text-secondary, #5C5272);
    margin: 0;
  }
</style>

<script>
  function setupTimeline() {
    let cleanupCurrentMode: (() => void) | null = null;

    function initMode() {
      const section = document.getElementById('journey');
      if (!section) return;

      if (cleanupCurrentMode) {
        cleanupCurrentMode();
        cleanupCurrentMode = null;
      }

      const isMobile = window.innerWidth <= 768;

      if (isMobile) {
        // Mobile scroll reveal with IntersectionObserver
        const mobileEntries = section.querySelectorAll<HTMLElement>('.mobile-milestone-entry');
        if (mobileEntries.length) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
              }
            });
          }, {
            threshold: 0.15,
            rootMargin: '0px 0px -40px 0px'
          });

          mobileEntries.forEach((el) => observer.observe(el));
          cleanupCurrentMode = () => observer.disconnect();
        }
        return;
      }

      // Desktop horizontal scrub track logic
      const track = document.getElementById('whole-slider-track');
      const journeyLine = section.querySelector('.journey-line') as HTMLElement | null;
      if (!track || !journeyLine) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const itemIds = [
        '2022-march',
        '2022-november',
        '2023-april',
        '2023-october',
        '2024-july',
        '2025-march',
        '2026-may'
      ];

      if (reduceMotion) {
        journeyLine.style.width = '100%';
        itemIds.forEach(id => {
          const line = section.querySelector(`.jl-${id}`) as HTMLElement | null;
          const dot = section.querySelector(`.jd-${id}`) as HTMLElement | null;
          const title = section.querySelector(`.title-${id}`) as HTMLElement | null;
          const desc = section.querySelector(`.description-${id}`) as HTMLElement | null;
          if (line) line.style.transform = 'scaleY(1)';
          if (dot) dot.style.transform = 'translateX(-50%) scale(1)';
          if (title) { title.style.transform = 'none'; title.style.opacity = '1'; }
          if (desc) { desc.style.transform = 'none'; desc.style.opacity = '1'; }
        });
        return;
      }

      let isVisible = true;
      let raf = 0;

      const desktopPositions = [
        [0.05, 0.18],
        [0.15, 0.28],
        [0.26, 0.40],
        [0.38, 0.52],
        [0.50, 0.65],
        [0.62, 0.77],
        [0.74, 0.88]
      ];

      const updateFrame = () => {
        raf = 0;
        if (!isVisible) return;

        const rect = section.getBoundingClientRect();
        const maxScroll = rect.height - window.innerHeight;
        if (maxScroll <= 0) return;

        const progress = Math.max(0, Math.min(1, -rect.top / maxScroll));

        // Calculate track total scroll amount dynamically
        const trackOverflow = Math.max(0, track.scrollWidth - window.innerWidth + 120);
        const shiftPx = progress * trackOverflow;
        track.style.transform = `translateX(-${shiftPx}px)`;

        // Central axis line expanding
        journeyLine.style.width = `${progress * 96}%`;

        // Staggered reveal for stems, dots, and text
        itemIds.forEach((id, index) => {
          const [start, end] = desktopPositions[index] || [0.1, 0.3];
          const itemP = Math.max(0, Math.min(1, (progress - start) / (end - start)));

          const line = section.querySelector(`.jl-${id}`) as HTMLElement | null;
          const dot = section.querySelector(`.jd-${id}`) as HTMLElement | null;
          const title = section.querySelector(`.title-${id}`) as HTMLElement | null;
          const desc = section.querySelector(`.description-${id}`) as HTMLElement | null;

          if (line) line.style.transform = `scaleY(${itemP})`;
          if (dot) dot.style.transform = `translateX(-50%) scale(${itemP})`;

          const yShift = (1 - itemP) * 30;
          const op = itemP > 0.1 ? itemP : 0;
          if (title) {
            title.style.transform = `translateY(${yShift}px)`;
            title.style.opacity = `${op}`;
          }
          if (desc) {
            desc.style.transform = `translateY(${yShift}px)`;
            desc.style.opacity = `${op}`;
          }
        });
      };

      const onScroll = () => {
        if (!raf && isVisible) {
          raf = requestAnimationFrame(updateFrame);
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });

      const observer = new IntersectionObserver(([entry]) => {
        isVisible = entry.isIntersecting;
        if (isVisible) onScroll();
      });
      observer.observe(section);

      updateFrame();

      cleanupCurrentMode = () => {
        window.removeEventListener('scroll', onScroll);
        if (raf) cancelAnimationFrame(raf);
        observer.disconnect();
      };
    }

    initMode();

    let resizeTimer: number;
    let lastWidth = window.innerWidth;
    const onWindowResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        const currentWidth = window.innerWidth;
        if ((lastWidth <= 768 && currentWidth > 768) || (lastWidth > 768 && currentWidth <= 768)) {
          initMode();
        } else if (currentWidth > 768) {
          initMode();
        }
        lastWidth = currentWidth;
      }, 150);
    };

    window.addEventListener('resize', onWindowResize, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTimeline);
  } else {
    setupTimeline();
  }
  document.addEventListener('astro:page-load', setupTimeline);
</script>
